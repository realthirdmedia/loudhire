# Enquiry form delivery.
#
# Option A (default, zero setup): FormSubmit forwards submissions to ENQUIRY_TO.
#   The first submission triggers a one-time activation email to that inbox.
# Option B: set RESEND_API_KEY (and a verified sending domain) to send via Resend instead.
ENQUIRY_TO=info@loudhire.co.uk
ENQUIRY_FROM=website@loudhire.co.uk
RESEND_API_KEY=

# Server-side only. Never expose this key to client-side code.
CURRENT_RMS_API_KEY=
CURRENT_RMS_STORE_ID=1
CURRENT_RMS_OWNER_ID=1
