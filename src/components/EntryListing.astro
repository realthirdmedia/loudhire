---
/**
 * Shared listing for News & Projects, with static filter links
 * (All / Projects / News / by service) so every view has its own URL.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EntryCard from '../components/EntryCard.astro';
import ContactSection from '../components/ContactSection.astro';
import { capabilities } from '../data/site';
import type { Entry } from '../lib/entries';

interface Props {
  entries: Entry[];
  active: string; // 'all' | 'projects' | 'news' | service key
  title: string;
  metaTitle: string;
  description: string;
  intro: string;
}
const { entries, active, title, metaTitle, description, intro } = Astro.props;

const filters = [
  { key: 'all', label: 'All', href: '/news-and-projects/' },
  { key: 'projects', label: 'Projects', href: '/news-and-projects/projects/' },
  { key: 'news', label: 'News', href: '/news-and-projects/news/' },
];
---

<Base title={metaTitle} description={description}>
  <PageHero
    variant="plain"
    eyebrow="News & Projects"
    title={title}
    intro={intro}
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'News & Projects', href: '/news-and-projects/' },
    ]}
  />

  <div class="filters">
    <div class="container filters__inner">
      <nav class="filters__group" aria-label="Show">
        {filters.map((f) => <a href={f.href} aria-current={active === f.key ? 'true' : undefined}>{f.label}</a>)}
      </nav>
      <nav class="filters__group filters__group--services" aria-label="Filter by service">
        <span class="filters__label">Service</span>
        {capabilities.map((c) => <a href={`/news-and-projects/service/${c.key}/`} aria-current={active === c.key ? 'true' : undefined}>{c.name}</a>)}
      </nav>
    </div>
  </div>

  <section class="section section--tight">
    <div class="container">
      {
        entries.length > 0 ? (
          <div class="grid grid--3">
            {entries.map((entry, i) => (
              <EntryCard entry={entry} eager={i < 3} />
            ))}
          </div>
        ) : (
          <p class="muted">Nothing here yet.</p>
        )
      }
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  .filters {
    border-bottom: 1px solid var(--c-line);
    background: var(--c-paper);
  }
  .filters__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-block: 0.85rem;
  }
  .filters__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .filters__label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-right: 0.35rem;
  }
  .filters__group a {
    display: inline-block;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--c-line);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-xs);
    color: var(--c-ink);
    text-decoration: none;
  }
  .filters__group a:hover {
    border-color: var(--c-orange);
    color: var(--c-orange-deep);
  }
  .filters__group a[aria-current='true'] {
    background: var(--c-black);
    border-color: var(--c-black);
    color: #fff;
  }
</style>
