---
/**
 * Short enquiry form. Works without JavaScript (plain POST to /api/enquiry,
 * which redirects to /thank-you/) and upgrades to an inline submit with fetch.
 */
interface Props {
  id?: string;
  heading?: string;
  /** Prefilled message, e.g. from a "Enquire about this item" link. */
  prefill?: string;
  dark?: boolean;
}
const { id = 'enquiry-form', heading, prefill = '', dark = false } = Astro.props;
---

<form
  class:list={['enquiry', { 'enquiry--dark': dark }]}
  id={id}
  method="post"
  action="/api/enquiry/"
  novalidate
  data-enquiry
>
  {heading && <h3 class="enquiry__heading">{heading}</h3>}
  <p class="enquiry__intro">
    Tell us what you are planning. If the date or the details are still undecided, that's fine: we can help you work them out.
  </p>

  <div class="enquiry__grid">
    <div class="field">
      <label for={`${id}-name`}>Name</label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email" required />
    </div>
    <div class="field">
      <label for={`${id}-phone`}>Phone <span class="hint">(optional)</span></label>
      <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" />
    </div>
    <div class="field">
      <label for={`${id}-location`}>Event location <span class="hint">(optional)</span></label>
      <input id={`${id}-location`} name="location" type="text" placeholder="Venue, town or postcode" />
    </div>
    <div class="field">
      <label for={`${id}-date`}>Event date <span class="hint">(optional)</span></label>
      <input id={`${id}-date`} name="date" type="text" placeholder="e.g. 14 June 2027, or 'summer 2027'" />
    </div>
    <div class="field field--check enquiry__undecided">
      <input id={`${id}-undecided`} name="undecided" type="checkbox" value="yes" />
      <label for={`${id}-undecided`}>Date or requirements not decided yet</label>
    </div>
    <div class="field enquiry__full">
      <label for={`${id}-message`}>Tell us about the event</label>
      <textarea id={`${id}-message`} name="message" required placeholder="What is it, roughly how many people, and what do you need help with?">{prefill}</textarea>
    </div>
  </div>

  <!-- Honeypot: left empty by people, filled by bots -->
  <div class="enquiry__hp" aria-hidden="true">
    <label for={`${id}-website`}>Website</label>
    <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="page" value={Astro.url.pathname} />

  <div class="enquiry__actions">
    <button class="btn btn--primary" type="submit">Send enquiry</button>
    <p class="enquiry__note">We aim to reply within one working day. No spam, no mailing lists.</p>
  </div>
  <p class="enquiry__status" role="status" aria-live="polite" hidden></p>
</form>

<style>
  .enquiry {
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .enquiry--dark {
    background: #161616;
    border-color: var(--c-line-dark);
  }
  .enquiry--dark .field label {
    color: #fff;
  }
  .enquiry--dark .field input,
  .enquiry--dark .field textarea {
    background: #0f0f0f;
    border-color: #3a3a3a;
    color: #fff;
  }
  .enquiry--dark .field--check label {
    color: var(--c-on-dark-muted);
  }
  .enquiry--dark .enquiry__intro,
  .enquiry--dark .enquiry__note,
  .enquiry--dark .field .hint {
    color: var(--c-on-dark-muted);
  }
  .enquiry__heading {
    margin-bottom: 0.4rem;
  }
  .enquiry__intro {
    color: var(--c-muted);
    font-size: var(--text-sm);
    margin-bottom: 1.5rem;
  }
  .enquiry__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem 1.25rem;
  }
  .enquiry__full {
    grid-column: 1 / -1;
  }
  .enquiry__undecided {
    align-self: end;
    padding-bottom: 0.7rem;
  }
  .enquiry__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .enquiry__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }
  .enquiry__note {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--c-muted);
  }
  .enquiry__status {
    margin: 1rem 0 0;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    font-weight: 500;
    background: var(--c-orange-soft);
    color: var(--c-ink);
  }
  .enquiry__status[data-state='error'] {
    background: #fdecec;
    color: #8a1f1f;
  }
  .enquiry__status[data-state='success'] {
    background: #e9f7ec;
    color: #1d5a2a;
  }
  @media (max-width: 40rem) {
    .enquiry__grid {
      grid-template-columns: 1fr;
    }
    .enquiry__undecided {
      padding-bottom: 0;
    }
    .enquiry__actions .btn {
      width: 100%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-enquiry]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.enquiry__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    const show = (state: 'error' | 'success' | 'info', text: string) => {
      status.hidden = false;
      status.dataset.state = state;
      status.textContent = text;
    };

    form.addEventListener('submit', async (event) => {
      // Native validation first
      if (!form.checkValidity()) {
        form.reportValidity();
        event.preventDefault();
        return;
      }
      event.preventDefault();
      button.disabled = true;
      const original = button.textContent;
      button.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          window.location.assign('/thank-you/');
          return;
        }
        show('error', data.error || 'Sorry, something went wrong. Please call us on 0117 214 1470 or email info@loudhire.co.uk.');
      } catch {
        show('error', 'Sorry, we could not send that. Please call us on 0117 214 1470 or email info@loudhire.co.uk.');
      } finally {
        button.disabled = false;
        button.textContent = original;
      }
    });
  });
</script>
