---
import { Image } from 'astro:assets';
import { equipmentImage, itemUrl, formatPrice, type EquipmentItem } from '../lib/equipment';

interface Props {
  item: EquipmentItem;
}
const { item } = Astro.props;
const img = equipmentImage(item);
const search = [item.name, item.category, item.description].join(' ').toLowerCase();
---

<a class="eq" href={itemUrl(item)} data-section={item.section} data-category={item.categorySlug} data-search={search}>
  <div class="eq__media">
    {img ? <Image src={img} alt={item.name} width={320} height={240} fit="contain" loading="lazy" decoding="async" format="webp" quality={70} /> : <span class="eq__none">No image</span>}
  </div>
  <div class="eq__body">
    <span class="eq__cat">{item.category.replace(/ - /g, ': ')}</span>
    <h3 class="eq__name">{item.name}</h3>
    <span class="eq__price">{formatPrice(item)}</span>
  </div>
</a>

<style>
  .eq {
    display: flex;
    flex-direction: column;
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .eq:hover {
    box-shadow: var(--shadow);
    border-color: #d8d5cf;
    color: inherit;
  }
  .eq__media {
    aspect-ratio: 4 / 3;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    border-bottom: 1px solid var(--c-line);
  }
  .eq__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .eq__none {
    font-size: var(--text-xs);
    color: var(--c-muted);
  }
  .eq__body {
    padding: 0.85rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .eq__cat {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .eq__name {
    font-size: 0.98rem;
    margin: 0;
    line-height: 1.3;
  }
  .eq__price {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--c-orange-deep);
    margin-top: 0.25rem;
  }
</style>
