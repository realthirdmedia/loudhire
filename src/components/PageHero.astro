---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** 'banner' = full-width photo behind the title; 'split' = text left, photo right; 'plain' = no photo. */
  variant?: 'banner' | 'split' | 'plain';
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  breadcrumb?: { label: string; href: string }[];
}
const {
  eyebrow,
  title,
  intro,
  image,
  imageAlt = '',
  variant = image ? 'split' : 'plain',
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  breadcrumb,
} = Astro.props;
---

<section class:list={['page-hero', `page-hero--${variant}`]}>
  {
    variant === 'banner' && image && (
      <div class="page-hero__bg">
        <Image src={image} alt={imageAlt} widths={[768, 1280, 1920, 2400]} sizes="100vw" loading="eager" decoding="async" fetchpriority="high" format="webp" quality={68} />
      </div>
    )
  }
  <div class="container page-hero__inner">
    <div class="page-hero__text">
      {
        breadcrumb && (
          <nav class="page-hero__crumb" aria-label="Breadcrumb">
            {breadcrumb.map((b, i) => (
              <>
                {i > 0 && <span aria-hidden="true">/</span>}
                <a href={b.href}>{b.label}</a>
              </>
            ))}
          </nav>
        )
      }
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {intro && <p class="page-hero__intro">{intro}</p>}
      {
        (ctaLabel || secondaryLabel) && (
          <div class="btn-row">
            {ctaLabel && ctaHref && (
              <a class="btn btn--primary" href={ctaHref}>
                {ctaLabel}
              </a>
            )}
            {secondaryLabel && secondaryHref && (
              <a class:list={['btn', variant === 'banner' ? 'btn--ghost-light' : 'btn--ghost']} href={secondaryHref}>
                {secondaryLabel}
              </a>
            )}
          </div>
        )
      }
    </div>
    {
      variant === 'split' && image && (
        <div class="page-hero__media">
          <Image src={image} alt={imageAlt} widths={[640, 960, 1280]} sizes="(max-width: 64rem) 92vw, 560px" loading="eager" decoding="async" fetchpriority="high" format="webp" quality={72} />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    background: var(--c-paper);
    border-bottom: 1px solid var(--c-line);
  }
  .page-hero__inner {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .page-hero h1 {
    max-width: 20ch;
  }
  .page-hero__intro {
    font-size: var(--text-lg);
    color: var(--c-muted);
    max-width: 56ch;
    margin-bottom: 1.5rem;
  }
  .page-hero__crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--c-muted);
    margin-bottom: 1rem;
  }
  .page-hero__crumb a {
    color: inherit;
    text-decoration: none;
  }
  .page-hero__crumb a:hover {
    color: var(--c-orange-deep);
  }

  /* split */
  .page-hero--split .page-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .page-hero__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--c-paper-3);
  }
  .page-hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* banner */
  .page-hero--banner {
    background: var(--c-black);
    color: #fff;
    border-bottom: 0;
    min-height: min(64vh, 36rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .page-hero--banner .page-hero__inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(8rem, 18vw, 12rem);
    width: 100%;
  }
  .page-hero__bg,
  .page-hero__bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .page-hero__bg :global(img) {
    object-fit: cover;
  }
  .page-hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.5) 45%, rgba(0, 0, 0, 0.2) 100%);
  }
  .page-hero--banner h1 {
    color: #fff;
  }
  .page-hero--banner .page-hero__intro {
    color: #e4e4e4;
  }
  .page-hero--banner .page-hero__crumb {
    color: #bdbdbd;
  }
  .page-hero--banner .page-hero__crumb a:hover {
    color: var(--c-orange);
  }
  .page-hero--banner .eyebrow {
    color: var(--c-orange);
  }

  @media (max-width: 64rem) {
    .page-hero--split .page-hero__inner {
      grid-template-columns: 1fr;
    }
    .page-hero__media {
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 40rem) {
    .btn-row .btn {
      width: 100%;
    }
  }
</style>
