---
/**
 * Closing enquiry section used on the homepage and service pages:
 * phone, email and the short enquiry form.
 */
import EnquiryForm from './EnquiryForm.astro';
import { site } from '../data/site';

interface Props {
  heading?: string;
  text?: string;
  prefill?: string;
  id?: string;
}
const {
  heading = 'Discuss your event',
  text = 'Tell us what you are planning and we will come back with a clear recommendation and a quote. Site visits across Bristol and the Cotswolds are free.',
  prefill = '',
  id = 'enquiry',
} = Astro.props;
---

<section class="section section--dark contact-section" id={id}>
  <div class="container contact-section__grid">
    <div class="contact-section__intro">
      <span class="eyebrow">Get in touch</span>
      <h2>{heading}</h2>
      <p class="lead">{text}</p>
      <ul class="contact-section__list">
        <li>
          <span class="contact-section__label">Call</span>
          <a href={site.phoneHref}>{site.phone}</a>
        </li>
        <li>
          <span class="contact-section__label">Email</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <span class="contact-section__label">WhatsApp</span>
          <a href={site.whatsapp} rel="noopener">Message us on WhatsApp</a>
        </li>
        <li>
          <span class="contact-section__label">Warehouse</span>
          <span>{site.addressLine}<br /><span class="muted">Visits by appointment</span></span>
        </li>
      </ul>
    </div>
    <div>
      <EnquiryForm id={`${id}-form`} dark />
    </div>
  </div>
</section>

<style>
  .contact-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .contact-section__list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1rem;
  }
  .contact-section__list li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--c-line-dark);
    line-height: 1.45;
  }
  .contact-section__list a {
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
  }
  .contact-section__list a:hover {
    color: var(--c-orange);
  }
  .contact-section__label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-orange);
    padding-top: 0.35rem;
  }
  .contact-section .muted {
    color: #8a8a8a;
  }
  @media (max-width: 64rem) {
    .contact-section__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
