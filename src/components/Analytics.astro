---
const openAiPixelId = 'JbaCgE7PfoABEfYDTU3U2d';
---

<section id="analytics-choice" class="analytics-choice" aria-label="Analytics cookies" data-openai-pixel-id={openAiPixelId} hidden>
  <div>
    <p>We use cookies on our site to provide you with the best experience. View our <a href="/privacy-policy/">privacy policy</a> to learn more.</p>
  </div>
  <div class="analytics-choice__actions">
    <button type="button" class="btn btn--primary analytics-choice__accept" data-analytics-choice="granted">Accept</button>
    <button type="button" class="btn btn--ghost btn--sm analytics-choice__decline" data-analytics-choice="denied">Decline</button>
  </div>
</section>

<script is:inline>
  (() => {
    // Keep development and Vercel previews out of the live measurement accounts.
    if (!['www.loudhire.co.uk', 'loudhire.co.uk'].includes(location.hostname)) return;
    const measurementId = 'G-0BRD96ZVY5';
    const storageKey = 'loudhire-measurement-choice-v2';
    const legacyKey = 'loudhire-analytics-choice-v1';
    const banner = document.getElementById('analytics-choice');
    const settings = document.querySelector('[data-analytics-settings]');
    if (!banner) return;
    const pixelId = banner.dataset.openaiPixelId;
    let googleLoaded = false;
    let openAiLoaded = false;
    let saved = null;
    let legacyChoice = null;
    try {
      saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
      if (!saved || saved.expires < Date.now()) saved = null;
      if (!saved) {
        const old = JSON.parse(localStorage.getItem(legacyKey) || 'null');
        if (old && old.expires > Date.now()) legacyChoice = old.choice;
      }
    } catch { saved = null; }

    const lead = new URLSearchParams(location.search).get('enquiry');
    const pageLead = location.pathname === '/thank-you/' && /^[a-f0-9-]{36}$/i.test(lead || '') ? lead : null;
    function once(platform, id) {
      const key = 'loudhire-' + platform + '-lead-' + id;
      try {
        if (sessionStorage.getItem(key)) return false;
        sessionStorage.setItem(key, '1');
      } catch {}
      return true;
    }
    function trackLead(id, type) {
      if (googleLoaded && once('google', id)) {
        window.gtag('event', 'contact_us', { event_id: id, enquiry_type: type });
      }
      if (openAiLoaded && once('openai', id)) {
        window.oaiq('measure', 'lead_created', { type: 'customer_action' }, { event_id: id, opt_out: true });
      }
    }

    function startGoogle(adsConsent) {
      if (googleLoaded) return;
      googleLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'granted',
        ad_storage: adsConsent ? 'granted' : 'denied',
        ad_user_data: adsConsent ? 'granted' : 'denied',
        ad_personalization: 'denied',
      });
      window.gtag('js', new Date());
      // Never pass arbitrary query strings or form contents into analytics.
      const page = new URL(location.origin + location.pathname);
      const query = new URLSearchParams(location.search);
      for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid']) {
        if (query.has(key)) page.searchParams.set(key, query.get(key));
      }
      let referrer = '';
      try {
        const url = new URL(document.referrer);
        referrer = url.origin + url.pathname;
      } catch {}
      window.gtag('config', measurementId, {
        page_location: page.href,
        page_referrer: referrer,
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
      document.head.append(script);
      if (pageLead) trackLead(pageLead, 'enquiry');
    }

    function startOpenAi() {
      if (openAiLoaded || !pixelId) return;
      openAiLoaded = true;
      const q = function () { q.q.push(arguments); };
      q.q = [];
      window.oaiq = q;
      window.oaiq('consent', true);
      window.oaiq('init', { pixelId });
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://bzrcdn.openai.com/sdk/oaiq.min.js';
      document.head.append(script);
      if (pageLead) trackLead(pageLead, 'enquiry');
    }

    if (settings) {
      settings.hidden = false;
      settings.addEventListener('click', () => {
        banner.hidden = false;
        banner.querySelector('button').focus();
      });
    }
    if ((saved && saved.google) || legacyChoice === 'granted') startGoogle(!!(saved && saved.google));
    if (saved && saved.openai) startOpenAi();
    if (!saved && !legacyChoice) banner.hidden = false;

    document.addEventListener('loudhire:lead', (event) => {
      const id = event.detail && event.detail.id;
      if (typeof id === 'string' && /^[a-z0-9-]{8,64}$/i.test(id)) trackLead(id, event.detail.type || 'enquiry');
    });
    document.addEventListener('click', (event) => {
      if (!event.target.closest('a[href^="tel:"]')) return;
      if (googleLoaded) window.gtag('event', 'phone_click', { event_category: 'contact' });
      if (openAiLoaded) window.oaiq('measure', 'custom', { type: 'custom' }, { custom_event_name: 'phone_clicked', opt_out: true });
    });

    function expireCookie(name) {
      for (const domain of ['', '; Domain=loudhire.co.uk', '; Domain=' + location.hostname]) {
        document.cookie = name + '=; Max-Age=0; Path=/' + domain + '; SameSite=Lax';
      }
    }
    function saveChoice(granted) {
      if (openAiLoaded && !granted) window.oaiq('consent', false);
      if (googleLoaded && !granted) {
        window['ga-disable-' + measurementId] = true;
        window.gtag('consent', 'update', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied' });
        for (const cookie of document.cookie.split(';')) {
          const name = cookie.split('=')[0].trim();
          if (/^_(?:ga|gcl)(?:_|$)/.test(name)) expireCookie(name);
        }
      }
      try {
        localStorage.setItem(storageKey, JSON.stringify({ google: granted, openai: granted, expires: Date.now() + 180 * 24 * 60 * 60 * 1000 }));
        localStorage.removeItem(legacyKey);
      } catch {}
      location.reload();
    }
    banner.querySelectorAll('[data-analytics-choice]').forEach((button) => {
      button.addEventListener('click', () => saveChoice(button.dataset.analyticsChoice === 'granted'));
    });
  })();
</script>

<style>
  .analytics-choice{position:fixed;bottom:1rem;left:1rem;right:1rem;z-index:1100;max-width:62rem;margin:auto;padding:1.2rem 1.4rem;background:#fff;color:var(--c-ink);border:1px solid var(--c-line);border-radius:var(--radius);box-shadow:0 4px 24px #0003;display:flex;align-items:center;gap:1.5rem}
  .analytics-choice p{font-size:var(--text-sm);margin:0}
  .analytics-choice a{text-decoration:underline}
  .analytics-choice__actions{display:flex;gap:.75rem;align-items:center;flex-shrink:0}
  .analytics-choice__actions button{appearance:none;-webkit-appearance:none;color:#000;min-height:44px}
  .analytics-choice__accept{min-width:10rem}
  .analytics-choice__decline{background:#fff;min-width:6rem}
  .analytics-choice__decline:hover{background:#f5f4f1;color:#000}
  @media(max-width:48rem){.analytics-choice{display:block}.analytics-choice__actions{margin-top:1rem}.analytics-choice__accept{flex:2;min-width:0}.analytics-choice__decline{flex:1;min-width:0}}
</style>
