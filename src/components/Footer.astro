---
import { site, nav, capabilities, eventTypes, cta } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__cta">
      <div>
        <p class="footer__cta-title">{site.tagline}</p>
        <p class="footer__cta-text">Based in Thornbury, serving {site.areas}.</p>
      </div>
      <a class="btn btn--primary" href={cta.href}>{cta.label}</a>
    </div>

    <div class="footer__grid">
      <div class="footer__col footer__col--brand">
        <a href="/" aria-label="Loud Hire home">
          <img src="/images/loud-hire-logo.png" alt="Loud Hire" width="341" height="101" loading="lazy" decoding="async" />
        </a>
        <address>
          {site.address.street}<br />
          {site.address.town}, {site.address.city}<br />
          {site.address.postcode}
        </address>
        <p>
          <a href={site.phoneHref}>{site.phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="footer__small">{site.hours}</p>
      </div>

      <div class="footer__col">
        <h4>Site</h4>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/privacy-policy/">Privacy policy</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>Event production</h4>
        <ul>
          {capabilities.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
          {eventTypes.map((e) => <li><a href={e.href}>{e.name}</a></li>)}
        </ul>
      </div>

      <div class="footer__col">
        <h4>Dry hire</h4>
        <ul>
          <li><a href="/dry-hire/">Equipment-only hire</a></li>
          <li><a href="/dry-hire/equipment/">Full equipment list</a></li>
          <li><a href="/dry-hire/#packages">Party PA packages</a></li>
          <li><a href="/dry-hire/#lease">Long-term lease for venues</a></li>
        </ul>
        <h4>Follow</h4>
        <ul>
          <li><a href={site.social.instagram} rel="noopener">Instagram</a></li>
          <li><a href={site.social.facebook} rel="noopener">Facebook</a></li>
          <li><a href={site.whatsapp} rel="noopener">WhatsApp</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} {site.legalName}. Sound, lighting, staging, video and power hire for Bristol, the Cotswolds and the South West.</p>
      <p>
        Sister company: <a href={site.sisterCompany.url} rel="noopener">{site.sisterCompany.name}</a>
        &middot; Marketing by <a href={site.marketingCredit.url} rel="noopener">{site.marketingCredit.name}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-black);
    color: var(--c-on-dark-muted);
    font-size: var(--text-sm);
    margin-top: auto;
  }
  .footer a {
    color: #e8e8e8;
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--c-orange);
  }
  .footer__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--c-line-dark);
  }
  .footer__cta-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-2xl);
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.35rem;
    max-width: 34ch;
    text-wrap: balance;
  }
  .footer__cta-text {
    margin: 0;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }
  .footer__col h4 {
    color: #fff;
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 0.9rem;
  }
  .footer__col h4 + ul + h4 {
    margin-top: 1.75rem;
  }
  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__col li + li {
    margin-top: 0.45rem;
  }
  .footer__col--brand img {
    height: 2.4rem;
    width: auto;
    margin-bottom: 1.25rem;
  }
  .footer__col--brand address {
    font-style: normal;
    margin-bottom: 0.9rem;
    line-height: 1.5;
  }
  .footer__small {
    font-size: var(--text-xs);
    color: #8a8a8a;
    max-width: 30ch;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--c-line-dark);
    font-size: var(--text-xs);
    color: #8a8a8a;
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__bottom a {
    color: #bdbdbd;
  }
  @media (max-width: 64rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 40rem) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
