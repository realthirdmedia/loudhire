---
import { nav, cta, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href="/" aria-label="Loud Hire home">
      <img src="/images/loud-hire-logo.png" alt="Loud Hire" width="341" height="101" decoding="async" fetchpriority="high" />
    </a>

    <nav class="header__nav" id="site-nav" aria-label="Main navigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="header__nav-contact">
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn--primary btn--sm header__cta" href={cta.href}>{cta.label}</a>
      <a class="header__basket" href="/quote/#quote-basket" aria-label="View quote basket, 0 items">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 9 2 11h10l2-11H5Z"/><path d="m9 9 3-6 3 6"/><path d="M9 13v3m3-3v3m3-3v3"/></svg>
        <span class="header__basket-count" hidden>0</span>
      </a>
      <button
        class="header__toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--c-black);
    color: #fff;
    border-bottom: 1px solid var(--c-line-dark);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }
  .header__logo img {
    height: 2.55rem;
    width: auto;
  }
  .header__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
  }
  .header__nav a {
    display: block;
    padding: 0.55rem 0.8rem;
    color: #e8e8e8;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
    border-radius: var(--radius);
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .header__nav a:hover {
    color: #fff;
    background: #1c1c1c;
  }
  .header__nav a[aria-current='page'] {
    color: var(--c-orange);
  }
  .header__nav-contact {
    display: none;
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .header__phone {
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .header__phone:hover {
    color: var(--c-orange);
  }
  .header__basket{display:none;position:relative;align-items:center;justify-content:center;width:2.75rem;height:2.75rem;border:1px solid #333;border-radius:var(--radius);color:#fff;text-decoration:none;flex:none}
  .header__basket:hover{color:var(--c-orange)}
  .header__basket svg{width:1.3rem;height:1.3rem}
  .header__basket-count:not([hidden]){position:absolute;top:-.45rem;right:-.45rem;display:grid;place-items:center;min-width:1.3rem;height:1.3rem;padding:0 .2rem;border-radius:999px;background:var(--c-orange);color:var(--c-black);font-size:.68rem;font-weight:800}
  .header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: 1px solid #333;
    border-radius: var(--radius);
    padding: 0;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .header__toggle span {
    display: block;
    width: 1.15rem;
    height: 2px;
    background: #fff;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .header__toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .header__toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .header__toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 96rem) {
    .header__phone {
      display: none;
    }
  }
  @media (max-width: 64rem) {
    .header__basket{display:flex}
    .header__toggle {
      display: flex;
    }
    .header__nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      background: var(--c-black);
      padding: 1.5rem var(--gutter) 2rem;
      overflow-y: auto;
      display: none;
      border-top: 1px solid var(--c-line-dark);
    }
    .header__nav[data-open] {
      display: block;
    }
    .header__nav ul {
      flex-direction: column;
      gap: 0;
    }
    .header__nav ul a {
      font-size: 1.25rem;
      padding: 0.9rem 0.25rem;
      border-bottom: 1px solid var(--c-line-dark);
      border-radius: 0;
    }
    .header__nav ul a:hover {
      background: transparent;
    }
    .header__nav-contact {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      margin-top: 1.5rem;
    }
    .header__nav-contact a {
      padding-inline: 0.25rem;
      color: var(--c-on-dark-muted);
    }
  }
  @media (max-width: 26rem) {
    .header__inner {
      gap: 0.75rem;
    }
    .header__actions {
      gap: 0.5rem;
    }
    .header__cta {display:none}
    .header__logo img {
      height: 2.1rem;
    }
  }
</style>

<script>
  const basketLink = document.querySelector<HTMLAnchorElement>('.header__basket');
  const basketBadge = document.querySelector<HTMLElement>('.header__basket-count');
  const updateBasketBadge = (count: number) => {
    if (!basketLink || !basketBadge) return;
    basketLink.setAttribute('aria-label', `View quote basket, ${count} item${count === 1 ? '' : 's'}`);
    basketBadge.textContent = count > 99 ? '99+' : String(count);
    basketBadge.hidden = count === 0;
  };
  try {
    const saved = JSON.parse(localStorage.getItem('loudhire-quote-basket-v1') || '[]');
    updateBasketBadge(Array.isArray(saved) ? saved.reduce((sum, line) => sum + (Number(line.quantity) || 0), 0) : 0);
  } catch { updateBasketBadge(0); }
  window.addEventListener('loudhire:basket-updated', ((event: CustomEvent<number>) => updateBasketBadge(event.detail)) as EventListener);
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const navEl = document.getElementById('site-nav');
  if (toggle && navEl) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) navEl.setAttribute('data-open', '');
      else navEl.removeAttribute('data-open');
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    window.matchMedia('(min-width: 64.01rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
