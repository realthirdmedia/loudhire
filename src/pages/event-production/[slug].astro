---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import EntryCard from '../../components/EntryCard.astro';
import ContactSection from '../../components/ContactSection.astro';
import { subPages, capabilityPages, eventTypePages } from '../../data/eventProduction';
import { capabilities } from '../../data/site';
import { getEntriesByIds, getProjectsForService, isProject } from '../../lib/entries';

export async function getStaticPaths() {
  return subPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;

// Explicit project list first, then fall back to anything tagged with the service.
let projects = await getEntriesByIds(page.projectIds);
if (page.service && projects.length < 3) {
  const tagged = await getProjectsForService(page.service);
  for (const t of tagged) if (!projects.find((p) => p.id === t.id)) projects.push(t);
}
projects = projects.filter(isProject).slice(0, 6);
const news = page.newsIds ? await getEntriesByIds(page.newsIds) : [];

const siblings = page.kind === 'capability' ? capabilityPages : eventTypePages;
const siblingLabel = page.kind === 'capability' ? 'Other capabilities' : 'Other event types';
const otherKind = page.kind === 'capability' ? eventTypePages : capabilityPages;
const otherLabel = page.kind === 'capability' ? 'Events we produce' : 'What we bring';

/** Render the simple body format: "## " prefix = heading, otherwise paragraph. */
const blocks = page.body.map((b) => (b.startsWith('## ') ? { h: b.slice(3) } : { p: b }));
---

<Base title={page.metaTitle} description={page.metaDescription}>
  <PageHero
    variant="split"
    image={page.image}
    imageAlt={page.imageAlt}
    eyebrow={page.kind === 'capability' ? 'Event production' : 'Complete production packages'}
    title={page.title}
    intro={page.intro}
    ctaLabel="Discuss your event"
    ctaHref="/contact/"
    secondaryLabel={page.equipmentSection ? 'Dry hire this equipment' : 'How we work'}
    secondaryHref={page.equipmentSection ? `/dry-hire/#${page.equipmentSection}` : '/event-production/#main'}
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Event Production', href: '/event-production/' },
      { label: page.navName, href: `/event-production/${page.slug}/` },
    ]}
  />

  <section class="section">
    <div class="container service">
      <div class="service__body prose">
        {blocks.map((b) => ('h' in b ? <h2>{b.h}</h2> : <p>{b.p}</p>))}
      </div>
      <aside class="service__aside">
        <div class="service__panel">
          <h3>{page.supplyHeading}</h3>
          <ul>
            {page.supply.map((s) => <li>{s}</li>)}
          </ul>
          {
            page.equipmentSection && (
              <a class="text-link" href={`/dry-hire/equipment/#${page.equipmentSection}`}>
                Browse the {page.navName.toLowerCase()} equipment list
              </a>
            )
          }
        </div>
        <div class="service__panel service__panel--links">
          <h3>{otherLabel}</h3>
          <ul class="service__links">
            {otherKind.map((o) => <li><a href={`/event-production/${o.slug}/`}>{o.navName}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="section section--paper-2">
        <div class="container">
          <div class="section-head section-head--split">
            <div>
              <span class="eyebrow">Projects</span>
              <h2>{page.kind === 'capability' ? `${page.navName} in practice` : `${page.navName} we have delivered`}</h2>
            </div>
            <a class="text-link" href={page.service ? `/news-and-projects/service/${page.service}/` : '/news-and-projects/projects/'}>
              {page.service ? `All ${page.navName.toLowerCase()} projects` : 'All projects'}
            </a>
          </div>
          <div class="grid grid--3">
            {projects.map((entry) => (
              <EntryCard entry={entry} showDate={false} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    news.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head section-head--split">
            <div>
              <span class="eyebrow">Related</span>
              <h2>News and guides</h2>
            </div>
            <a class="text-link" href="/news-and-projects/news/">All news</a>
          </div>
          <div class="grid grid--3">
            {news.slice(0, 3).map((entry) => (
              <EntryCard entry={entry} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--tight divider">
    <div class="container">
      <p class="siblings__label">{siblingLabel}</p>
      <ul class="siblings">
        {
          siblings
            .filter((s) => s.slug !== page.slug)
            .map((s) => (
              <li>
                <a href={`/event-production/${s.slug}/`}>{s.navName}</a>
              </li>
            ))
        }
        {page.kind === 'capability' && capabilities.length && <li><a href="/event-production/">All event production</a></li>}
      </ul>
    </div>
  </section>

  <ContactSection
    heading={page.kind === 'capability' ? `Discuss ${page.navName.toLowerCase()} for your event` : 'Discuss your event'}
  />
</Base>

<style>
  .service {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .service__body :global(h2:first-child) {
    margin-top: 0;
  }
  .service__aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: 1.25rem;
  }
  .service__panel {
    background: var(--c-paper-2);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.6rem;
  }
  .service__panel h3 {
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .service__panel ul {
    margin: 0 0 1rem;
    padding-left: 1.1rem;
    font-size: var(--text-sm);
    color: var(--c-body);
  }
  .service__panel li + li {
    margin-top: 0.4rem;
  }
  .service__panel--links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .service__links a {
    display: block;
    padding: 0.45rem 0;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-ink);
    border-bottom: 1px solid var(--c-line);
  }
  .service__links li:last-child a {
    border-bottom: 0;
  }
  .siblings__label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: 0.75rem;
  }
  .siblings {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .siblings a {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--c-ink);
  }
  .siblings a:hover {
    border-color: var(--c-orange);
    color: var(--c-orange-deep);
  }
  @media (max-width: 64rem) {
    .service {
      grid-template-columns: 1fr;
    }
    .service__aside {
      position: static;
    }
  }
</style>
