---
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import EquipmentCard from '../../../../components/EquipmentCard.astro';
import ContactSection from '../../../../components/ContactSection.astro';
import { categories, itemsInCategory, sectionName, categoryUrl } from '../../../../lib/equipment';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const items = itemsInCategory(category.slug);
const siblings = categories.filter((c) => c.section === category.section && c.slug !== category.slug);

const title = `${category.name} Hire | ${sectionName(category.section)} Dry Hire near Bristol`;
const description = `${items.length} ${category.name.toLowerCase()} items for dry hire from Loud Hire in Thornbury, near Bristol. Day and week rates, collection or delivery across the South West.`;
---

<Base title={title} description={description}>
  <PageHero
    variant="plain"
    eyebrow={`Dry hire · ${sectionName(category.section)}`}
    title={category.name}
    intro={`${items.length} item${items.length === 1 ? '' : 's'} available for equipment-only hire. Prices are per day excluding VAT where shown.`}
    ctaLabel="Enquire about equipment hire"
    ctaHref={`/contact/?subject=${encodeURIComponent(`dry-hire: ${category.name}`)}#enquiry`}
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Dry Hire', href: '/dry-hire/' },
      { label: 'Equipment list', href: '/dry-hire/equipment/' },
      { label: category.name, href: categoryUrl(category) },
    ]}
  />
  <section class="section section--tight">
    <div class="container">
      <div class="eq-grid">
        {items.map((item) => <EquipmentCard item={item} />)}
      </div>
      {
        siblings.length > 0 && (
          <div class="siblings">
            <p>Other {sectionName(category.section).toLowerCase()} categories</p>
            <div class="tag-row">
              {siblings.map((s) => (
                <a class="tag tag--outline" href={categoryUrl(s)}>
                  {s.name} ({s.count})
                </a>
              ))}
              <a class="tag" href={`/dry-hire/equipment/#${category.section}`}>
                All {sectionName(category.section).toLowerCase()}
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>
  <ContactSection heading="Enquire about equipment hire" text="Send us the dates and the list, and we will confirm availability and quote the whole hire." />
</Base>

<style>
  .eq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
    gap: 1rem;
  }
  .siblings {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line);
  }
  .siblings p {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  @media (max-width: 40rem) {
    .eq-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
