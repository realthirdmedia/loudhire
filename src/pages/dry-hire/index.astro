---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ContactSection from '../../components/ContactSection.astro';
import equipment from '../../data/equipment.json';
import heroImage from '../../assets/news/wireless-microphone-hire/28-channels.jpg';
import imgSound from '../../assets/news/danley-sound-labs-pa/j7-bc415.jpg';
import imgLighting from '../../assets/projects/aerospace-bristol-5th-anniversary/desk.jpg';
import imgStaging from '../../assets/pages/stagemobil.jpg';
import imgVideo from '../../assets/pages/conference-screens.jpg';
import imgPower from '../../assets/pages/distro-32a.jpg';
import imgAccessories from '../../assets/pages/cable-63a.jpg';

const counts = equipment.reduce<Record<string, number>>((acc, item) => {
  acc[item.section] = (acc[item.section] || 0) + 1;
  return acc;
}, {});

const sections = [
  {
    key: 'sound',
    name: 'Sound',
    image: imgSound,
    alt: 'Danley J7-95 loudspeaker stacked on a BC415 subwoofer in the warehouse',
    text: 'Loudspeakers from a single powered speaker to a Danley J7 system, subwoofers, amplifiers, digital mixers, wired and wireless microphones, in-ear monitoring and DI boxes.',
    kit: 'Danley J7-95, SM80 and BC415 · Martin Audio W8LM, W8C, WS218X and LE12J · Electro-Voice ETX and ZLX · Allen & Heath SQ5, SQ6, CQ18T and Avantis · Sennheiser EW-D wireless racks · Shure, sE, AKG and Audix microphones',
  },
  {
    key: 'lighting',
    name: 'Lighting',
    image: imgLighting,
    alt: 'Lighting console in the foreground with a blue-lit aircraft behind',
    text: 'LED washes, moving heads, fresnels, profiles, pars, battens, followspots, consoles, dimmers, DMX distribution, festoon, uplighters, outdoor floods and effects.',
    kit: 'Chauvet Maverick MK2 and Ovation F-915FC · Spectra pars, battens and floods · Elumen8 Hex pars and Tour Batten sunstrips · ETC Source Four and Selecon · LDR followspots · ChamSys MQ70 and Zero 88 FLX · festoon from 7.5m to 100m',
  },
  {
    key: 'staging',
    name: 'Staging',
    image: imgStaging,
    alt: 'Stagemobil XXL trailer stage set up on a racecourse',
    text: 'Litedeck panels in four sizes with legs, pit rail and cable access, our Konligo Fastival stage roof, truss, chain hoists, stands and rigging hardware. Trailer stages through Big Stage Hire.',
    kit: 'Litedeck 8x4, 4x4, 8x2 and 4x2 · Konligo Fastival roof · F34 truss · CM Lodestar and manual chain hoists · crank stands and speaker stands · Stagemobil L and XXL with Big Stage Hire',
  },
  {
    key: 'video',
    name: 'Video',
    image: imgVideo,
    alt: 'Large display screens set up in a marquee with picnic benches',
    text: 'Our 3.9mm outdoor-rated LED video wall in any configuration, 55 to 85 inch commercial displays, a 6,100-lumen laser projector and fast-fold screens. Playback and switching available with technical support.',
    kit: '3.9mm LED video wall with Novastar processing · 55 to 85 inch displays · Sony VPL-FHZ66 laser projector · fast-fold rear projection screen',
  },
  {
    key: 'power',
    name: 'Power',
    image: imgPower,
    alt: '32A single-phase power distribution unit',
    text: 'Generators, three-phase and single-phase distribution, 63A, 32A and 16A cabling, Socapex, PowerCon and 13A leads, tower lights and battery and inverter packs.',
    kit: 'FG Wilson 20kVA, 60kVA road-tow and JCB 105kVA and 115kVA generators · 63A and 32A distros · mains cable in all standard lengths · Generac VB9 tower light · 1,000W inverter and 76Ah battery packs',
  },
  {
    key: 'accessories',
    name: 'Accessories',
    image: imgAccessories,
    alt: 'Coiled 63A three-phase cable',
    text: 'Speaker, microphone and control cabling, DMX, stage boxes, antenna distribution, networking and the small items that make a hire complete.',
    kit: 'NL2, NL4 and NL8 speaker cable · XLR and multicores · 3-pin and 5-pin DMX · Sennheiser antenna distribution · rack-mount routers · cable ramps',
  },
];

const packages = [
  { name: 'Mini Rave', price: '£35', spec: '1,000W speaker on a stand, one cable, set up in two minutes. House parties and small gatherings, indoors or under cover.' },
  { name: 'Rave', price: '£55', spec: '2,000W two-speaker package with a link cable so you can put a speaker in a second room. Medium-sized birthdays and small weddings.' },
  { name: 'Ibiza', price: '£155', spec: '6,000W package with subwoofers for real low end, tops stacked on the subs so the footprint stays small. Ten-minute set-up.' },
  { name: 'Ibiza XL', price: '£200', spec: '7,200W with full range and headroom for bands as well as playlists. Weddings, large parties and live music.' },
];

const faqs = [
  { q: 'Can anyone dry hire from you?', a: 'Yes. We hire to other production companies, venues, bands, DJs, schools, churches and occasional customers alike. If you are providing services for an event and need extra stock, get in touch.' },
  { q: 'Collection or delivery?', a: 'Collect from our Thornbury warehouse by appointment, Monday to Friday, 9am to 5pm, or ask us to quote for delivery. We deliver anywhere in the UK.' },
  { q: 'How much notice do you need?', a: 'We stock most of the items in the equipment list. If it is not already booked, you can often collect it the same day.' },
  { q: 'What about insurance?', a: 'For dry hire we ask customers to take responsibility for insuring the equipment and its safe use while it is on hire. Loud Hire itself is fully insured for public liability, employers’ liability and professional indemnity.' },
  { q: 'Do you offer set-up or training?', a: 'Yes. For wireless microphone racks, mixers and lighting consoles we can include set-up and basic training for technicians who are new to our systems.' },
  { q: 'How are prices shown?', a: 'Prices in the equipment list are per day excluding VAT where listed; weekly rates are available and many items are priced on enquiry. Tell us the dates and the list and we will quote the lot.' },
];

const title = 'Dry Hire: Sound, Lighting, Staging, Video & Power Equipment Hire | Thornbury, Bristol';
const description =
  'Equipment-only hire from our Thornbury warehouse near Bristol: PA systems, microphones, mixers, stage lighting, Litedeck staging, LED video wall, generators, distribution and cabling. Collection or delivery, day and week rates, open to production companies and occasional customers.';
---

<Base title={title} description={description}>
  <PageHero
    variant="split"
    image={heroImage}
    imageAlt="Racks holding 28 channels of Sennheiser wireless microphones ready for hire"
    eyebrow="Dry hire"
    title="Equipment-only hire from Thornbury, near Bristol."
    intro="Tested, cased and ready to go: sound, lighting, staging, video, power and accessories for production companies, venues, bands and one-off events. Collect from our warehouse or have it delivered."
    ctaLabel="Enquire about equipment hire"
    ctaHref="/contact/?subject=dry-hire#enquiry"
    secondaryLabel="Browse the full equipment list"
    secondaryHref="/dry-hire/equipment/"
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Dry Hire', href: '/dry-hire/' },
    ]}
  />

  <section class="section section--tight">
    <div class="container how">
      <div>
        <h2>How dry hire works</h2>
        <p>
          Dry hire means you hire the equipment on its own and run it yourself. It suits other production companies topping up stock, venues and theatres with their own technicians, and bands, DJs and occasional customers who just need a reliable PA or some lighting for a night.
        </p>
      </div>
      <ol class="how__steps">
        <li><strong>Tell us what you need</strong> and the dates. If you are not sure which system suits the job, we will recommend one.</li>
        <li><strong>We prep and test it.</strong> Everything is checked in our warehouse before it goes out and again when it comes back.</li>
        <li><strong>Collect or have it delivered.</strong> Collection from Thornbury by appointment, or delivery quoted for anywhere in the UK.</li>
      </ol>
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we hire</span>
        <h2>Six sections, one warehouse.</h2>
        <p>Everything below is our own stock. Prices are per day excluding VAT where shown; weekly rates and package prices are available on enquiry.</p>
      </div>
      <div class="sections">
        {
          sections.map((s) => (
            <article class="dh" id={s.key}>
              <div class="dh__media">
                <Image src={s.image} alt={s.alt} widths={[480, 720, 960]} sizes="(max-width: 48rem) 92vw, 360px" loading="lazy" decoding="async" format="webp" quality={70} />
              </div>
              <div class="dh__body">
                <h3>{s.name}</h3>
                <p>{s.text}</p>
                <p class="dh__kit">{s.kit}</p>
                <div class="btn-row">
                  <a class="btn btn--dark btn--sm" href={`/dry-hire/equipment/#${s.key}`}>
                    {s.name} equipment list ({counts[s.key] || 0})
                  </a>
                  <a class="text-link" href={`/contact/?subject=dry-hire-${s.key}#enquiry`}>Enquire</a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="packages">
    <div class="container packages">
      <div class="section-head">
        <span class="eyebrow">Personal use</span>
        <h2>Party PA packages</h2>
        <p>
          Got a playlist and need it loud? Our Bluetooth party packages connect to any phone and come with an optional microphone. Pick the size that suits the room and we will have it ready to collect.
        </p>
      </div>
      <div class="packages__grid">
        {
          packages.map((p) => (
            <div class="pkg">
              <h3>{p.name}</h3>
              <p class="pkg__price">
                {p.price} <span>+ VAT per day</span>
              </p>
              <p>{p.spec}</p>
              <a class="text-link" href={`/contact/?subject=${encodeURIComponent(`${p.name} party package`)}#enquiry`}>Check availability</a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--paper-2" id="lease">
    <div class="container lease">
      <div>
        <span class="eyebrow">Venues</span>
        <h2>Long-term lease for venues</h2>
      </div>
      <div class="lease__body">
        <p>
          For venues that need a permanent sound or lighting system without the capital cost, we offer long-term lease agreements tailored to the room. Unexpected repair, maintenance and replacement costs become our problem rather than yours, and you keep up-to-date equipment for the length of the contract.
        </p>
        <p>
          After a visit we usually put forward three to five system options across a range of budgets. Whichever you choose comes with seven-day support: if something fails, we fix it, and from Thornbury we are rarely more than an hour from a venue in Bristol, Bath or the Cotswolds. Our hire stock also covers any temporary extras you need alongside the installed system.
        </p>
        <a class="btn btn--ghost" href="/contact/?subject=venue-lease#enquiry">Discuss a venue lease</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Dry hire questions</h2>
      </div>
      <dl class="faq">
        {
          faqs.map((f) => (
            <div class="faq__item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <ContactSection
    heading="Enquire about equipment hire"
    text="Send us the dates and a list, or just describe the event, and we will quote the whole hire. Collection from Thornbury or delivery anywhere in the UK."
  />
</Base>

<style>
  .how {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .how__steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 1rem;
  }
  .how__steps li {
    counter-increment: step;
    position: relative;
    padding: 1rem 1.25rem 1rem 3.5rem;
    background: var(--c-paper-2);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    color: var(--c-muted);
  }
  .how__steps li::before {
    content: counter(step);
    position: absolute;
    left: 1.1rem;
    top: 0.95rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--c-black);
    color: var(--c-orange);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sections {
    display: grid;
    gap: 1.25rem;
  }
  .dh {
    display: grid;
    grid-template-columns: 22rem minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .dh__media {
    background: var(--c-paper-3);
    min-height: 14rem;
  }
  .dh__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dh__body {
    padding: 1.6rem 1.75rem 1.6rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .dh__body h3 {
    margin: 0;
    font-size: 1.5rem;
  }
  .dh__body p {
    margin: 0;
  }
  .dh__kit {
    font-size: var(--text-xs);
    color: var(--c-muted);
    line-height: 1.55;
  }
  .dh__body .btn-row {
    margin-top: 0.75rem;
  }
  .packages__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .pkg {
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pkg h3 {
    margin: 0;
  }
  .pkg p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--c-muted);
    flex: 1;
  }
  .pkg__price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--c-ink) !important;
    flex: 0 !important;
  }
  .pkg__price span {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--c-muted);
  }
  .lease {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(2rem, 5vw, 4rem);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .faq {
    margin: 0;
  }
  .faq__item {
    padding: 1.25rem 0;
    border-top: 1px solid var(--c-line);
  }
  .faq__item:last-child {
    border-bottom: 1px solid var(--c-line);
  }
  .faq dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--c-ink);
    margin-bottom: 0.4rem;
  }
  .faq dd {
    margin: 0;
    color: var(--c-muted);
  }
  @media (max-width: 64rem) {
    .how,
    .lease {
      grid-template-columns: 1fr;
    }
    .dh {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
    .packages__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 48rem) {
    .dh {
      grid-template-columns: 1fr;
    }
    .dh__media {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
    .dh__body {
      padding: 0 1.4rem 1.5rem;
    }
    .packages__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
