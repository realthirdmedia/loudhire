---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import ContactSection from '../components/ContactSection.astro';
import CapabilityGrid from '../components/CapabilityGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import { site, cta, eventTypes, testimonials } from '../data/site';
import { getLatest, getEntriesByIds, entryUrl } from '../lib/entries';
import heroImage from '../assets/pages/hero-konligo.jpg';
import hawkstoneWall from '../assets/news/led-video-wall-hire/hawkstone-viewing.jpg';

const [hawkstone] = await getEntriesByIds(['hawkstone-advert-launch']);
const selected = await getEntriesByIds([
  'downend-fireworks-lighting',
  'the-wurzels-bath-racecourse',
  'aerospace-bristol-5th-anniversary',
]);
const latest = await getLatest(3);
const quotes = testimonials.slice(0, 3);

const title = 'Event Production Bristol & the Cotswolds | Sound, Lighting, Staging, Video & Power';
const description =
  'Loud Hire delivers complete event production across Bristol, the Cotswolds and the South West: sound, lighting, staging, video and power from one team, based in Thornbury. Discuss your corporate event, brand launch, festival or private event.';
---

<Base title={title} description={description}>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="hero__media">
      <Image
        src={heroImage}
        alt="Outdoor stage with a lit roof at dusk, crowd dancing and the Cotswold hills behind"
        widths={[768, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        format="webp"
        quality={70}
      />
    </div>
    <div class="container hero__content">
      <p class="hero__strap">{site.tagline}</p>
      <h1>Complete event production across Bristol and the Cotswolds.</h1>
      <p class="hero__text">
        Loud Hire brings together sound, lighting, staging, video and power, with technical planning and delivery tailored to your event. One team, one plan, from the first brief to the final breakdown.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={cta.href}>{cta.label}</a>
        <a class="btn btn--ghost-light" href="/news-and-projects/projects/">Explore our work</a>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="trust">
    <div class="container trust__inner">
      <p><strong>Based in Thornbury</strong> serving Bristol, the Cotswolds and the wider South West</p>
      <p><strong>30+ years</strong> in professional audio and events</p>
      <p><strong>300+ events</strong> supplied in a single year</p>
      <p><strong>Fully insured</strong> public liability, employers' liability and professional indemnity</p>
    </div>
  </section>

  <!-- 2. Hawkstone feature -->
  {
    hawkstone && (
      <section class="section feature">
        <div class="container feature__grid">
          <a class="feature__media" href={entryUrl(hawkstone)} aria-label={hawkstone.data.title}>
            <Image
              src={hawkstone.data.cover}
              alt={hawkstone.data.coverAlt}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 64rem) 92vw, 720px"
              loading="lazy"
              decoding="async"
              format="webp"
              quality={74}
            />
          </a>
          <div class="feature__body">
            <span class="eyebrow">Featured project</span>
            <h2>{hawkstone.data.title}</h2>
            <p class="lead">{hawkstone.data.brief}</p>
            <ul class="feature__list">
              {hawkstone.data.servicesDelivered?.slice(0, 5).map((item) => <li>{item}</li>)}
            </ul>
            <div class="btn-row">
              <a class="btn btn--dark" href={entryUrl(hawkstone)}>Read the full story</a>
            </div>
            <a class="feature__aside" href="/news-and-projects/led-video-wall-hire/">
              <Image
                src={hawkstoneWall}
                alt="Crowd watching a live broadcast on an outdoor LED wall at The Farmer's Dog"
                widths={[240, 480]}
                sizes="120px"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={70}
              />
              <span>
                <strong>Also for Hawkstone:</strong> live broadcast viewing on our LED wall at The Farmer's Dog and a screen for the VIP area at FarmFest.
                <span class="feature__aside-link">Read about our video walls →</span>
              </span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- 3. Capabilities -->
  <section class="section section--paper-2">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">What we deliver</span>
        <h2>Sound, lighting, staging, video and power.</h2>
        <p>
          Five disciplines, one production partner. Coordinating them through one team means one site visit, one technical plan, one crew and one point of contact, so nothing falls between suppliers on the day.
        </p>
      </div>
      <CapabilityGrid />
    </div>
  </section>

  <!-- 4. Complete production packages -->
  <section class="section packages">
    <div class="container packages__grid">
      <div>
        <span class="eyebrow">Complete production packages</span>
        <h2>One team for the whole event.</h2>
        <p class="lead">
          We plan and deliver complete production packages for corporate events, brand launches, company celebrations, festivals and private events across Bristol, the Cotswolds and the South West.
        </p>
        <p>
          It starts with your brief and, wherever possible, a site visit. We turn that into a technical plan covering the stage, sound, lighting, video and power the event actually needs, then install it, support it while the event runs and break it down afterwards. Booking everything together makes the most of crew and transport, and it means the people who planned the event are the people on site.
        </p>
        <ul class="packages__types">
          {eventTypes.map((e) => <li><a href={e.href}>{e.name}</a></li>)}
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href="/event-production/">Event production services</a>
          <a class="text-link" href="/contact/">Talk through your event</a>
        </div>
      </div>
      <ProcessSteps />
    </div>
  </section>

  <!-- 5. Selected projects and feedback -->
  <section class="section section--paper-2">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">Selected projects</span>
          <h2>Experience you can check.</h2>
          <p>Real events, real kit lists and the people who booked us.</p>
        </div>
        <a class="text-link" href="/news-and-projects/projects/">All projects</a>
      </div>
      <div class="grid grid--3">
        {selected.map((entry) => <EntryCard entry={entry} showDate={false} />)}
      </div>
      <div class="quotes">
        {
          quotes.map((q) => (
            <figure class="quote">
              <blockquote>
                <p>"{q.quote}"</p>
              </blockquote>
              <figcaption>
                <strong>{q.name}</strong>
                <span>{q.context}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Latest news and projects -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow">Latest</span>
          <h2>News and projects</h2>
        </div>
      </div>
      <div class="grid grid--3">
        {latest.map((entry) => <EntryCard entry={entry} />)}
      </div>
      <p class="latest__more">
        <a class="btn btn--ghost" href="/news-and-projects/">See our latest news and projects</a>
      </p>
    </div>
  </section>

  <!-- 7. Enquiry -->
  <ContactSection />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: min(88vh, 52rem);
    display: flex;
    align-items: flex-end;
    background: var(--c-black);
    color: #fff;
    overflow: hidden;
  }
  .hero__media,
  .hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__media :global(img) {
    object-fit: cover;
    object-position: 50% 45%;
  }
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.55) 40%, rgba(0, 0, 0, 0.15) 75%, rgba(0, 0, 0, 0.25) 100%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 7vw, 5.5rem);
    max-width: var(--container);
  }
  .hero__strap {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: #fff;
    margin: 0 0 1.25rem;
    padding: 0.55rem 0.9rem 0.55rem 0.8rem;
    border-left: 3px solid var(--c-orange);
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 100%;
  }
  .hero h1 {
    color: #fff;
    max-width: 16ch;
    margin-bottom: 1rem;
  }
  .hero__text {
    font-size: var(--text-lg);
    max-width: 52ch;
    color: #e6e6e6;
    margin-bottom: 1.75rem;
  }

  /* Trust strip */
  .trust {
    background: var(--c-paper);
    border-bottom: 1px solid var(--c-line);
  }
  .trust__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem 2rem;
    padding-block: 1.25rem;
    font-size: var(--text-sm);
    color: var(--c-muted);
  }
  .trust__inner p {
    margin: 0;
    line-height: 1.4;
  }
  .trust__inner strong {
    display: block;
    color: var(--c-ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
  }

  /* Feature */
  .feature__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .feature__media {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--c-paper-3);
  }
  .feature__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feature__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: grid;
    gap: 0.5rem;
    font-size: var(--text-sm);
  }
  .feature__list li {
    padding-left: 1.4rem;
    position: relative;
  }
  .feature__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 2px;
    background: var(--c-orange);
  }
  .feature__aside {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    align-items: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line);
    text-decoration: none;
    font-size: var(--text-sm);
    color: var(--c-muted);
  }
  .feature__aside :global(img) {
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }
  .feature__aside-link {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--c-ink);
  }
  .feature__aside:hover .feature__aside-link {
    color: var(--c-orange-deep);
  }

  /* Packages */
  .packages__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .packages__types {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .packages__types a {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--c-ink);
    text-decoration: none;
    background: var(--c-paper);
  }
  .packages__types a:hover {
    border-color: var(--c-orange);
    color: var(--c-orange-deep);
  }

  /* Quotes */
  .quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .quote {
    margin: 0;
    padding: 1.6rem 1.6rem 1.5rem;
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
  }
  .quote blockquote {
    margin: 0 0 1rem;
  }
  .quote blockquote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--c-ink);
  }
  .quote figcaption {
    font-size: var(--text-xs);
    color: var(--c-muted);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .quote figcaption strong {
    color: var(--c-ink);
  }

  .latest__more {
    margin: 2.5rem 0 0;
    text-align: center;
  }

  @media (max-width: 64rem) {
    .trust__inner {
      grid-template-columns: repeat(2, 1fr);
    }
    .feature__grid,
    .packages__grid {
      grid-template-columns: 1fr;
    }
    .quotes {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 40rem) {
    .hero {
      min-height: 0;
    }
    .hero__content {
      padding-top: 9rem;
    }
    .hero__strap {
      display: none;
    }
    .trust__inner {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .hero__text {
      font-size: var(--text-base);
    }
    .btn-row .btn {
      width: 100%;
    }
  }
</style>
