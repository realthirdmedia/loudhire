---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { quotePackages } from '../lib/quotePackages';

const pounds = (value: number) => `£${value.toLocaleString('en-GB')}`;
---

<Base title="Build a hire quote | Loud Hire" description="Choose equipment and event production packages, add your dates and venue, and ask Loud Hire for a tailored quote. No payment or account needed.">
  <PageHero
    variant="plain"
    eyebrow="Quote basket"
    title="Build your hire request"
    intro="Choose a production package or build your own equipment basket, add your dates, then send one request. No payment or account needed."
    breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Quote basket', href: '/quote/' }]}
  />

  <section class="section section--tight">
    <div class="container quote-layout">
      <div class="quote-main">
        <div class="quote-screen-nav" id="quote-screen-nav" hidden>
          <a href="/quote/">← Choose again</a>
        </div>
        <div class="quote-panel quote-choice" id="quote-choice">
          <span class="eyebrow">1 / Choose your route</span>
          <h2>How would you like to start?</h2>
          <p>Start with a set production package or choose the equipment yourself. Both routes use the same basket and enquiry form.</p>
          <div class="quote-choice__options">
            <button class="quote-route" type="button" data-quote-mode="packages" aria-pressed="false">
              <strong>Pre-built package</strong><span>Choose a hire package from Loud Hire’s live catalogue or a festival or corporate setup.</span><em>Browse packages →</em>
            </button>
            <button class="quote-route" type="button" data-quote-mode="equipment" aria-pressed="false">
              <strong>Bespoke package</strong><span>Pick the exact sound, lighting, staging and other hire items you need from the live catalogue.</span><em>Build your package →</em>
            </button>
          </div>
        </div>

        <aside class="quote-route-sidebar" id="quote-route-sidebar" aria-label="Quote options" hidden>
          <h3>Start with</h3>
          <button class="quote-sidebar-mode" type="button" data-sidebar-mode="packages" aria-current="false">Pre-built packages</button>
          <button class="quote-sidebar-mode" type="button" data-sidebar-mode="equipment" aria-current="false">Bespoke package</button>
          <nav id="catalog-categories-nav" aria-label="Equipment categories" hidden>
            <h3>Categories</h3>
            <div id="catalog-category-list" class="catalog-category-list"></div>
          </nav>
        </aside>

        <div class="quote-panel" id="equipment" hidden>
          <div class="quote-heading">
            <div><span class="eyebrow">1 / Build your package</span><h2>Bespoke package</h2></div>
            <p>Products are pulled from Loud Hire’s Current RMS catalogue. Rates are indicative and availability is confirmed after your request.</p>
          </div>
          <div class="catalog-controls">
            <label><span class="visually-hidden">Search equipment</span><input id="catalog-search" type="search" placeholder="Search all equipment" /></label>
          </div>
          <h3 id="catalog-results-heading">Equipment</h3>
          <p id="catalog-status" class="muted" role="status">Loading the live equipment list…</p>
          <div id="catalog-list" class="catalog-grid" aria-live="polite"></div>
          <button id="catalog-more" class="btn btn--outline" type="button" hidden>Show more equipment</button>
        </div>

        <div class="quote-panel" id="packages" hidden>
          <div class="quote-heading">
            <div><span class="eyebrow">1 / Choose a package</span><h2>Pre-built packages</h2></div>
            <p>Starting prices exclude VAT. We’ll tailor the final quote to the venue, schedule and any extras.</p>
          </div>
          <div class="package-tabs" role="tablist" aria-label="Package type">
            <button type="button" class="package-tab" data-package-tab="RMS hire" aria-selected="true">Equipment hire packages</button>
            <button type="button" class="package-tab" data-package-tab="Festival production" aria-selected="false">Festival production</button>
            <button type="button" class="package-tab" data-package-tab="Corporate AV" aria-selected="false">Corporate AV</button>
          </div>
          <label id="rms-package-search-wrap" class="catalog-controls"><span class="visually-hidden">Search hire packages</span><input id="rms-package-search" type="search" placeholder="Search hire packages, e.g. RCF or radio mic" /></label>
          <p id="rms-package-status" class="muted" role="status">Loading hire packages from Current RMS…</p>
          <div id="rms-package-list" class="catalog-grid"></div>
          <div class="package-grid">
            {quotePackages.map((pkg) => (
              <article class="package-card" data-package-group={pkg.group} data-package-id={pkg.id} hidden>
                <span class="package-card__type">{pkg.duration}</span>
                <h3>{pkg.name}</h3>
                <p>{pkg.description}</p>
                <ul>{pkg.details.map((detail) => <li>{detail}</li>)}</ul>
                <div class="package-card__foot">
                  <strong>From {pounds(pkg.price)} <small>+ VAT</small></strong>
                  <button class="btn btn--primary btn--sm package-add" type="button" data-package-id={pkg.id}>Add to basket</button>
                </div>
              </article>
            ))}
          </div>
          <p class="muted package-note" hidden>Festival headline prices are for DJ setups and a 4–5 hour show per day. Full band and other extras can be requested in the basket. Corporate package engineer hours will be confirmed in the final quote.</p>
        </div>

        <form id="quote-form" class="quote-panel" novalidate hidden>
          <div class="quote-heading"><div><span class="eyebrow">2 / Tell us when</span><h2>Dates and venues</h2></div></div>
          <div id="periods">
            <fieldset class="period-card">
              <legend>Date range 1</legend>
              <div class="form-grid">
                <label>From <input type="date" name="start" required /></label>
                <label>To <input type="date" name="end" required /></label>
              </div>
              <label>Venue name and address <textarea name="venue" rows="2" required placeholder="Venue, street, town and postcode"></textarea></label>
              <div class="service-options" aria-label="Services needed">
                <label><input type="checkbox" name="delivery" /> Delivery</label>
                <label><input type="checkbox" name="collection" /> Collection</label>
                <label><input type="checkbox" name="setup" /> Setup</label>
                <label><input type="checkbox" name="engineer" /> Engineer</label>
              </div>
              <button class="period-remove text-link" type="button" hidden>Remove date range</button>
            </fieldset>
          </div>
          <button id="add-period" class="btn btn--outline btn--sm" type="button">+ Add another date range</button>

          <div class="quote-heading contact-heading"><div><span class="eyebrow">3 / Your details</span><h2>Where should we send the quote?</h2></div></div>
          <div class="form-grid">
            <label>Organisation name <input name="organisation" autocomplete="organization" required maxlength="120" /></label>
            <label>Your name <input name="name" autocomplete="name" required maxlength="120" /></label>
            <label>Email <input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
            <label>Phone <input name="phone" type="tel" autocomplete="tel" required maxlength="60" /></label>
          </div>
          <label>Organisation address <textarea name="address" rows="2" autocomplete="street-address" required maxlength="300"></textarea></label>
          <label>Anything else we should know? <textarea name="notes" rows="4" maxlength="3000" placeholder="Event timings, access, extras or questions"></textarea></label>
          <div class="visually-hidden" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <p class="form-fineprint">This sends an enquiry, not a booking. Loud Hire will check availability and send a tailored quote. No payment is taken.</p>
          <p id="quote-message" role="status" aria-live="polite"></p>
          <button id="quote-submit" class="btn btn--primary" type="submit">Send quote request</button>
        </form>
      </div>

      <aside class="basket" id="quote-basket" aria-label="Quote basket" hidden>
        <div class="basket__heading"><h2>Your basket</h2><span id="basket-count">0 items</span></div>
        <div id="basket-lines"><p class="muted">Your basket is empty. Add equipment or a package to get started.</p></div>
        <p class="basket__note">Prices shown are guides, excluding VAT. We’ll confirm availability, hire period and any service charges before you commit.</p>
        <a class="btn btn--primary basket__cta" href="#quote-form">Continue to dates and details</a>
      </aside>
    </div>
    <p id="basket-feedback" class="basket-feedback" role="status" aria-live="polite" hidden></p>
    <dialog id="product-config" class="product-config" aria-labelledby="product-config-title">
      <form method="dialog"><button class="product-config__close" type="submit" aria-label="Close package details">×</button></form>
      <span class="eyebrow">Build your package</span>
      <h2 id="product-config-title"></h2>
      <p id="product-config-prices" class="muted"></p>
      <p class="muted">Quantities below are per package. Fixed components are included automatically.</p>
      <div id="product-config-components"></div>
      <label class="product-config__quantity">Number of packages <input id="product-config-quantity" type="number" min="1" max="100" value="1" /></label>
      <p id="product-config-total" class="product-config__total"></p>
      <button id="product-config-add" class="btn btn--primary" type="button">Add to basket</button>
    </dialog>
  </section>
</Base>

<style is:global>
  .quote-layout{display:grid;grid-template-columns:minmax(0,1fr) 20rem;gap:2rem;align-items:start}.quote-main{display:grid;gap:1.5rem}.quote-panel,.basket{border:1px solid var(--c-line);border-radius:var(--radius-lg);background:var(--c-paper);padding:clamp(1.2rem,3vw,2rem)}.quote-heading{display:flex;justify-content:space-between;gap:1.5rem;align-items:end;margin-bottom:1.4rem}.quote-heading h2{margin:.2rem 0 0}.quote-heading p{max-width:32rem;margin:0;color:var(--c-muted);font-size:var(--text-sm)}.catalog-controls{display:flex;gap:.75rem;margin-bottom:1.25rem}.catalog-controls label:first-child{flex:1}.catalog-controls input,.catalog-controls select,#quote-form input:not([type=checkbox]),#quote-form textarea{width:100%;font:inherit;padding:.75rem;border:1px solid #cbc8c1;border-radius:var(--radius);background:white}.catalog-controls select{min-width:12rem}.catalog-grid,.package-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(13rem,1fr));gap:1rem}.catalog-card,.package-card{border:1px solid var(--c-line);border-radius:var(--radius);background:#fff;overflow:hidden;display:flex;flex-direction:column}.catalog-card__image{height:9rem;display:flex;align-items:center;justify-content:center;background:#faf9f6}.catalog-card__image img{width:100%;height:100%;object-fit:contain}.catalog-card__body{padding:1rem;display:flex;flex-direction:column;gap:.5rem;flex:1}.catalog-card__group,.package-card__type{font-size:.72rem;text-transform:uppercase;letter-spacing:.07em;font-weight:800;color:var(--c-orange-deep)}.catalog-card h3,.package-card h3{font-size:1rem;line-height:1.35;margin:0}.catalog-card p,.package-card p{font-size:var(--text-xs);color:var(--c-muted);margin:0}.catalog-card__foot{margin-top:auto;padding-top:.5rem;display:grid;gap:.6rem}.catalog-card__foot strong{font-size:.82rem}.catalog-card__foot button{width:100%}#catalog-more{margin-top:1.2rem}.package-tabs{display:flex;gap:.5rem;margin-bottom:1.2rem;flex-wrap:wrap}.package-tab{font:inherit;font-weight:700;border:1px solid var(--c-line);background:#fff;border-radius:999px;padding:.6rem 1rem;cursor:pointer}.package-tab[aria-selected=true]{background:var(--c-black);color:white}.package-card{padding:1.1rem;gap:.7rem}.package-card[hidden]{display:none}.package-card ul{padding-left:1rem;margin:.1rem 0;color:var(--c-muted);font-size:var(--text-xs);line-height:1.5;flex:1}.package-card__foot{border-top:1px solid var(--c-line);padding-top:.8rem;display:grid;gap:.7rem}.package-card__foot small{font-size:.7rem}.package-note{font-size:var(--text-xs);margin:1rem 0 0}.basket{position:sticky;top:calc(var(--header-h) + 1rem)}.basket__heading{display:flex;justify-content:space-between;align-items:center;gap:.5rem}.basket__heading h2{font-size:1.3rem;margin:0}.basket__heading span{font-size:var(--text-xs);color:var(--c-muted)}.basket-line{padding:1rem 0;border-bottom:1px solid var(--c-line)}.basket-line strong{display:block;font-size:.9rem}.basket-line small{display:block;color:var(--c-muted);margin:.25rem 0}.basket-line__actions{display:flex;align-items:center;gap:.5rem;margin-top:.5rem}.basket-line__actions button{font:inherit;border:1px solid var(--c-line);background:#fff;border-radius:var(--radius);width:1.8rem;height:1.8rem;cursor:pointer}.basket-line__actions .remove{width:auto;border:0;color:var(--c-orange-deep);margin-left:auto}.basket__note,.form-fineprint{font-size:var(--text-xs);color:var(--c-muted);line-height:1.5}.basket__cta{width:100%;text-align:center}.period-card{border:1px solid var(--c-line);border-radius:var(--radius);padding:1rem;margin:0 0 1rem;display:grid;gap:1rem}.period-card legend{font-weight:800;padding:0 .3rem}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}#quote-form label{display:grid;gap:.35rem;font-size:var(--text-sm);font-weight:700}#quote-form>label{margin-top:1rem}.service-options{display:flex;flex-wrap:wrap;gap:.6rem 1rem}.service-options label{display:flex!important;align-items:center;gap:.4rem!important;font-weight:500!important}.service-options input{accent-color:var(--c-orange)}.period-remove{justify-self:start}.contact-heading{margin-top:2.2rem}#quote-message{font-size:var(--text-sm)}#quote-message:not(:empty){padding:.8rem;border-radius:var(--radius);background:#fff2df}#quote-message[data-success]{background:#e7f4e9;color:#145125}@media(max-width:66rem){.quote-layout{grid-template-columns:1fr}.basket{position:static;grid-row:1}}@media(max-width:42rem){.quote-heading{display:block}.quote-heading p{margin-top:.5rem}.catalog-controls,.form-grid{display:grid;grid-template-columns:1fr}.catalog-grid,.package-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:30rem){.catalog-grid,.package-grid{grid-template-columns:1fr}}
  .basket-feedback:not([hidden]){position:fixed;z-index:40;right:1rem;bottom:1rem;max-width:min(25rem,calc(100vw - 2rem));margin:0;padding:.8rem 1rem;border-radius:var(--radius);background:var(--c-black);color:white;box-shadow:0 8px 24px #0003;font-size:var(--text-sm)}
  .product-config{width:min(42rem,calc(100vw - 2rem));max-height:min(88vh,60rem);overflow:auto;border:1px solid var(--c-line);border-radius:var(--radius-lg);padding:clamp(1.2rem,3vw,2rem);box-shadow:0 20px 70px #0005;background:var(--c-paper);color:var(--c-black)}.product-config::backdrop{background:#10151ac9}.product-config h2{margin:.3rem 2rem .4rem 0}.product-config p{font-size:var(--text-sm)}.product-config__close{float:right;border:0;background:transparent;font-size:2rem;line-height:1;cursor:pointer}.product-config__row{display:grid;grid-template-columns:minmax(0,1fr) 6rem;gap:.8rem;align-items:center;padding:.8rem 0;border-bottom:1px solid var(--c-line)}.product-config__row strong{display:block;font-size:var(--text-sm)}.product-config__row small{display:block;color:var(--c-muted);font-size:var(--text-xs);margin-top:.2rem}.product-config__row input,.product-config__quantity input{width:100%;padding:.55rem;border:1px solid #cbc8c1;border-radius:var(--radius);font:inherit}.product-config__row input:disabled{background:#eee;color:var(--c-muted)}.product-config__quantity{display:grid;grid-template-columns:1fr 6rem;align-items:center;gap:.8rem;margin:1rem 0;font-weight:700;font-size:var(--text-sm)}.product-config__total{font-weight:800}.basket-components{display:grid;gap:.25rem;padding:.6rem 0}.basket-components small{margin:0!important}.basket-components button{justify-self:start;border:0;padding:0;background:none;color:var(--c-orange-deep);font:inherit;font-size:var(--text-xs);font-weight:800;cursor:pointer}
  #rms-package-list[hidden],#rms-package-status[hidden],#rms-package-search-wrap[hidden],.package-note[hidden]{display:none}
  .quote-choice h2{margin:.35rem 0}.quote-choice>p{margin:0 0 1.25rem;color:var(--c-muted);font-size:var(--text-sm)}.quote-choice__options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.quote-route{display:grid;align-content:start;gap:.55rem;text-align:left;padding:1.25rem;border:2px solid var(--c-line);border-radius:var(--radius-lg);background:white;cursor:pointer;font:inherit;color:inherit}.quote-route:hover,.quote-route[aria-pressed=true]{border-color:var(--c-orange)}.quote-route strong{font-size:1.15rem}.quote-route span{color:var(--c-muted);font-size:var(--text-sm)}.quote-route em{font-style:normal;font-weight:800;color:var(--c-orange-deep);margin-top:.25rem}.quote-route:focus-visible{outline:3px solid var(--c-orange-deep);outline-offset:3px}#equipment,#packages,#quote-basket{scroll-margin-top:calc(var(--header-h) + 1rem)}
  .quote-screen-nav:not([hidden]){display:flex;justify-content:space-between;align-items:center;gap:1rem;font-size:var(--text-sm);font-weight:800}.quote-screen-nav a,.quote-screen-nav button{color:var(--c-orange-deep);font:inherit;text-decoration:none}.quote-screen-nav button{padding:0;border:0;background:none;cursor:pointer}
  #catalog-more[hidden],#quote-route-sidebar[hidden],#catalog-categories-nav[hidden]{display:none}
  .quote-main{grid-template-columns:10.5rem minmax(0,1fr);align-items:start}
  #quote-choice,#quote-screen-nav{grid-column:1/-1}
  #equipment,#packages,#quote-form{grid-column:2;min-width:0}
  .quote-route-sidebar{grid-column:1;grid-row:2/span 2;display:grid;gap:.35rem;position:sticky;top:calc(var(--header-h) + 1rem);max-height:calc(100vh - var(--header-h) - 2rem);overflow-y:auto;min-width:0;scroll-margin-top:calc(var(--header-h) + 1rem)}
  .quote-route-sidebar h3,#catalog-results-heading{font-size:1.15rem;margin:0 0 .75rem}
  .quote-sidebar-mode{width:100%;padding:.7rem .55rem;border:1px solid var(--c-line);border-radius:var(--radius);background:#fff;text-align:left;color:var(--c-black);font:inherit;font-size:.82rem;font-weight:800;cursor:pointer}
  .quote-sidebar-mode[aria-current=true]{border-color:var(--c-orange);background:var(--c-black);color:white}
  #catalog-categories-nav{margin-top:1rem}
  .catalog-category-list{display:grid;gap:.35rem}
  .catalog-category{display:flex;align-items:center;gap:.55rem;min-width:0;width:100%;padding:.55rem;text-align:left;border:1px solid transparent;border-radius:var(--radius);background:transparent;color:var(--c-black);font:inherit;cursor:pointer}
  .catalog-category:hover{background:#fff6ed}.catalog-category[aria-current=true]{border-color:var(--c-orange);background:#fff;color:var(--c-orange-deep);box-shadow:0 2px 8px #0000000d}
  .catalog-category:focus-visible,.quote-sidebar-mode:focus-visible{outline:3px solid var(--c-orange-deep);outline-offset:2px}
  .catalog-category__image{display:flex;align-items:center;justify-content:center;flex:none;width:2.4rem;height:2.4rem;overflow:hidden;border-radius:.4rem;background:#f4f0e9;color:var(--c-orange-deep);font-size:1.25rem}
  .catalog-category__image img{width:100%;height:100%;object-fit:contain}
  .catalog-category__copy{display:grid;gap:.12rem;min-width:0}
  .catalog-category__name{font-size:.78rem;font-weight:800;line-height:1.2;overflow-wrap:anywhere}
  .catalog-category__count{font-size:.68rem;color:var(--c-muted)}
  #equipment #catalog-status{margin:.25rem 0 1rem;font-size:var(--text-sm)}
  #equipment .catalog-grid{grid-template-columns:repeat(auto-fill,minmax(11rem,1fr))}
  @media(max-width:42rem){.quote-main{grid-template-columns:1fr}.quote-route-sidebar{grid-column:1;grid-row:auto;position:static;max-height:none;overflow:visible;grid-template-columns:repeat(2,minmax(0,1fr))}.quote-route-sidebar h3{grid-column:1/-1}.quote-sidebar-mode{height:100%}#catalog-categories-nav{grid-column:1/-1;min-width:0}.catalog-category-list{display:flex;overflow-x:auto;gap:.45rem;padding:.1rem .1rem .6rem;scroll-snap-type:x proximity}.catalog-category{flex:0 0 9rem;scroll-snap-align:start;background:#fff;border-color:var(--c-line)}#equipment,#packages,#quote-form{grid-column:1}}
  @media(max-width:30rem){#equipment .catalog-grid{grid-template-columns:1fr}}
  @media(max-width:42rem){.quote-choice__options{grid-template-columns:1fr}}
</style>

<script>
  import { quotePackages, type QuotePackage } from '../lib/quotePackages';
  import type { RmsProduct, RmsProductDetail } from '../lib/currentRms';

  type BasketLine = { type: 'product' | 'package'; id: number | string; quantity: number; fullBand?: boolean; components?: Record<string, number> };
  const storeKey = 'loudhire-quote-basket-v1';
  const readBasket = (): BasketLine[] => {
    try { const value = JSON.parse(localStorage.getItem(storeKey) || '[]'); return Array.isArray(value) ? value : []; }
    catch { return []; }
  };
  let basket = readBasket();
  let products: RmsProduct[] = [];
  const details = new Map<number, RmsProductDetail>();
  let activeDetail: RmsProductDetail | null = null;
  let editingIndex: number | null = null;
  let visibleCount = 24;
  let selectedGroup: string | null = null;
  const byId = (id: string) => document.getElementById(id)!;
  const list = byId('catalog-list');
  const status = byId('catalog-status');
  const basketLines = byId('basket-lines');
  const basketFeedback = byId('basket-feedback');
  let feedbackTimeout: number | undefined;
  const search = byId('catalog-search') as HTMLInputElement;
  const pounds = (value: number) => `£${value.toLocaleString('en-GB', { maximumFractionDigits: 2 })}`;
  const rateText = (product: RmsProduct) => {
    if (product.weekPrice === null || product.weekPrice === 0) return 'Price to confirm';
    return `${product.dayPrice === null ? 'Day rate on request' : `${pounds(product.dayPrice)} / day`} · ${pounds(product.weekPrice)} / week + VAT`;
  };
  search.value = new URLSearchParams(location.search).get('search') || '';
  const routeButtons = document.querySelectorAll<HTMLButtonElement>('.quote-route');
  const showRoute = (mode: 'packages' | 'equipment', scroll = false) => {
    byId('quote-choice').hidden = true;
    byId('quote-screen-nav').hidden = false;
    byId('quote-route-sidebar').hidden = false;
    byId('catalog-categories-nav').hidden = mode !== 'equipment';
    byId('quote-form').hidden = false;
    byId('quote-basket').hidden = false;
    byId('packages').hidden = mode !== 'packages';
    byId('equipment').hidden = mode !== 'equipment';
    localStorage.setItem('loudhire-quote-mode', mode);
    routeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.quoteMode === mode)));
    document.querySelectorAll<HTMLButtonElement>('.quote-sidebar-mode').forEach((button) => {
      button.setAttribute('aria-current', String(button.dataset.sidebarMode === mode));
    });
    if (scroll) (matchMedia('(max-width:42rem)').matches ? byId('quote-route-sidebar') : byId(mode))
      .scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  const selectRoute = (mode: 'packages' | 'equipment') => {
    showRoute(mode, true);
    history.pushState(null, '', `${location.pathname}${location.search}#${mode}`);
  };
  routeButtons.forEach((button) => button.addEventListener('click', () => {
    selectRoute(button.dataset.quoteMode as 'packages' | 'equipment');
  }));
  document.querySelectorAll<HTMLButtonElement>('.quote-sidebar-mode').forEach((button) => button.addEventListener('click', () => {
    selectRoute(button.dataset.sidebarMode as 'packages' | 'equipment');
  }));
  const routeFromUrl = (): 'packages' | 'equipment' | null => {
    if (location.hash === '#packages') return 'packages';
    if (location.hash === '#equipment' || search.value) return 'equipment';
    if (location.hash === '#quote-basket' || location.hash === '#quote-form') return localStorage.getItem('loudhire-quote-mode') === 'packages' ? 'packages' : 'equipment';
    return null;
  };
  const initialRoute = routeFromUrl();
  if (initialRoute) {
    showRoute(initialRoute);
    if (location.hash) requestAnimationFrame(() => (matchMedia('(max-width:42rem)').matches &&
      (initialRoute === 'packages' || initialRoute === 'equipment') ? byId('quote-route-sidebar') : byId(location.hash.slice(1))).scrollIntoView());
  }
  window.addEventListener('hashchange', () => { const mode = routeFromUrl(); if (mode) showRoute(mode); });
  window.addEventListener('popstate', () => { const mode = routeFromUrl(); if (mode) showRoute(mode); else location.reload(); });
  const el = (tag: string, className?: string, value?: string) => {
    const node = document.createElement(tag); if (className) node.className = className;
    if (value !== undefined) node.textContent = value; return node;
  };
  const save = () => { localStorage.setItem(storeKey, JSON.stringify(basket)); renderBasket(); };
  const add = (type: BasketLine['type'], id: BasketLine['id']) => {
    const existing = basket.find((line) => line.type === type && String(line.id) === String(id));
    if (existing) existing.quantity = Math.min(100, existing.quantity + 1);
    else basket.push({ type, id, quantity: 1 });
    save();
    const item = type === 'product' ? products.find((product) => product.id === Number(id)) : quotePackages.find((pkg) => pkg.id === id);
    basketFeedback.textContent = `${item?.name || 'Item'} added to your basket`;
    basketFeedback.hidden = false;
    window.clearTimeout(feedbackTimeout);
    feedbackTimeout = window.setTimeout(() => { basketFeedback.hidden = true; }, 2800);
  };

  const configDialog = byId('product-config') as HTMLDialogElement;
  const configComponents = byId('product-config-components');
  const configQuantity = byId('product-config-quantity') as HTMLInputElement;
  async function loadDetail(id: number): Promise<RmsProductDetail> {
    if (details.has(id)) return details.get(id)!;
    const response = await fetch(`/api/quote-product/${id}`);
    if (!response.ok) throw new Error('Package details could not be loaded. Please try again.');
    const result = await response.json() as { product: RmsProductDetail };
    details.set(id, result.product);
    return result.product;
  }
  function configValues() {
    const values: Record<string, number> = {};
    for (const input of configComponents.querySelectorAll<HTMLInputElement>('input[data-component-id]')) {
      values[input.dataset.componentId!] = Math.max(0, Math.min(100, Math.floor(Number(input.value) || 0)));
    }
    return values;
  }
  function packageGuide(detail: RmsProductDetail, values: Record<string, number>, count: number) {
    let week = detail.weekPrice ?? 0;
    let day = detail.dayPrice ?? 0;
    let weekKnown = detail.weekPrice !== null;
    let dayKnown = detail.dayPrice !== null;
    for (const component of detail.components) {
      const quantity = component.inclusion === 'mandatory' ? component.quantity :
        values[String(component.id)] ?? (component.inclusion === 'default' ? component.quantity : 0);
      if (!quantity || component.zeroPriced) continue;
      if (component.weekPrice === null) weekKnown = false; else week += component.weekPrice * quantity;
      if (component.dayPrice === null) dayKnown = false; else day += component.dayPrice * quantity;
    }
    return `${dayKnown && day > 0 ? `${pounds(day * count)} / day` : 'Day rate to confirm'} · ${weekKnown && week > 0 ? `${pounds(week * count)} / week` : 'week rate to confirm'} + VAT`;
  }
  function updateConfigTotal() {
    if (!activeDetail) return;
    const count = Math.max(1, Math.min(100, Math.floor(Number(configQuantity.value) || 1)));
    byId('product-config-total').textContent = `Guide for ${count} package${count === 1 ? '' : 's'}: ${packageGuide(activeDetail, configValues(), count)}`;
  }
  async function openConfig(id: number, index: number | null = null) {
    const button = byId('product-config-add') as HTMLButtonElement;
    button.disabled = true;
    const detail = await loadDetail(id);
    activeDetail = detail;
    editingIndex = index;
    byId('product-config-title').textContent = detail.name;
    byId('product-config-prices').textContent = detail.weekPrice === 0 && detail.components.length
      ? 'Price based on selected equipment and extras' : rateText(detail);
    const saved = index === null ? undefined : basket[index];
    configQuantity.value = String(saved?.quantity ?? 1);
    configComponents.replaceChildren();
    for (const component of detail.components) {
      const row = el('label', 'product-config__row');
      const copy = el('span');
      copy.append(el('strong', '', component.name), el('small', '', `${component.inclusion === 'mandatory' ? 'Fixed component' : component.inclusion === 'default' ? 'Included by default · editable' : 'Optional · starts at zero'}${component.zeroPriced ? ' · no extra charge' : component.weekPrice === null ? ' · price to confirm' : ` · ${pounds(component.weekPrice)} / week each`}`));
      const input = document.createElement('input'); input.type = 'number'; input.min = '0'; input.max = '100'; input.step = '1';
      input.dataset.componentId = String(component.id);
      input.value = String(component.inclusion === 'mandatory' ? component.quantity : saved?.components?.[String(component.id)] ?? (component.inclusion === 'default' ? component.quantity : 0));
      input.disabled = component.inclusion === 'mandatory';
      input.setAttribute('aria-label', `Quantity of ${component.name} per package`);
      input.addEventListener('input', updateConfigTotal);
      row.append(copy, input); configComponents.append(row);
    }
    button.textContent = index === null ? 'Add to basket' : 'Update basket';
    button.disabled = false;
    updateConfigTotal();
    configDialog.showModal();
  }
  configQuantity.addEventListener('input', updateConfigTotal);
  byId('product-config-add').addEventListener('click', () => {
    if (!activeDetail) return;
    const quantity = Math.floor(Number(configQuantity.value));
    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 100) { configQuantity.reportValidity(); return; }
    const line: BasketLine = { type: 'product', id: activeDetail.id, quantity, components: configValues() };
    if (editingIndex === null) basket.push(line); else basket[editingIndex] = line;
    save(); configDialog.close();
    basketFeedback.textContent = `${activeDetail.name} ${editingIndex === null ? 'added to' : 'updated in'} your basket`;
    basketFeedback.hidden = false;
    window.clearTimeout(feedbackTimeout);
    feedbackTimeout = window.setTimeout(() => { basketFeedback.hidden = true; }, 2800);
  });

  function renderCategoryNav() {
    const equipment = products.filter((p) => !p.isPackage);
    const categories = new Map<string, { count: number; image: string | null }>();
    for (const product of equipment) {
      const category = categories.get(product.group) || { count: 0, image: null };
      category.count += 1;
      category.image ||= product.image;
      categories.set(product.group, category);
    }
    const featured = ['Speakers', 'Microphones', 'Mixers', 'Amplifiers', 'DJ decks/players', 'Lighting', 'Staging', 'Video', 'Power'];
    const names = [...categories.keys()].sort((a, b) => {
      const aRank = featured.indexOf(a); const bRank = featured.indexOf(b);
      if (aRank !== -1 || bRank !== -1) return (aRank === -1 ? featured.length : aRank) - (bRank === -1 ? featured.length : bRank);
      return a.localeCompare(b);
    });
    selectedGroup ??= names[0] || null;
    const categoryList = byId('catalog-category-list');
    categoryList.replaceChildren();
    function addCategory(name: string | null, count: number, image: string | null) {
      const button = el('button', 'catalog-category') as HTMLButtonElement;
      button.type = 'button'; button.dataset.group = name || '';
      const thumb = el('span', 'catalog-category__image');
      if (image) { const img = document.createElement('img'); img.src = image; img.alt = ''; img.loading = 'lazy'; thumb.append(img); }
      else thumb.textContent = name ? '◈' : '▦';
      const copy = el('span', 'catalog-category__copy');
      copy.append(el('span', 'catalog-category__name', name || 'View all'),
        el('span', 'catalog-category__count', `${count} item${count === 1 ? '' : 's'}`));
      button.append(thumb, copy);
      button.addEventListener('click', () => { search.value = ''; selectedGroup = name; visibleCount = 24; renderCatalog(); });
      categoryList.append(button);
    }
    addCategory(null, equipment.length, null);
    for (const name of names) {
      const category = categories.get(name)!;
      addCategory(name, category.count, category.image);
    }
  }

  function renderCatalog() {
    const query = search.value.trim().toLowerCase();
    const filtered = products.filter((p) => !p.isPackage && (query || selectedGroup === null || p.group === selectedGroup) &&
      `${p.name} ${p.group} ${p.description}`.toLowerCase().includes(query));
    byId('catalog-results-heading').textContent = query ? 'Search results' : selectedGroup || 'All equipment';
    document.querySelectorAll<HTMLButtonElement>('.catalog-category').forEach((button) => {
      button.setAttribute('aria-current', String(!query && button.dataset.group === (selectedGroup || '')));
    });
    list.replaceChildren();
    for (const product of filtered.slice(0, visibleCount)) {
      const card = el('article', 'catalog-card');
      const media = el('div', 'catalog-card__image');
      if (product.image) { const img = document.createElement('img'); img.src = product.image; img.alt = ''; img.loading = 'lazy'; media.append(img); }
      else media.textContent = 'Image coming soon';
      const body = el('div', 'catalog-card__body');
      body.append(el('span', 'catalog-card__group', product.group), el('h3', '', product.name));
      const foot = el('div', 'catalog-card__foot');
      foot.append(el('strong', '', rateText(product)));
      const button = el('button', 'btn btn--primary btn--sm', product.hasAccessories ? 'Configure & add' : 'Add to basket') as HTMLButtonElement;
      button.type = 'button'; button.addEventListener('click', () => {
        if (product.hasAccessories) openConfig(product.id).catch(() => { status.textContent = 'Package details could not be loaded. Please try again.'; });
        else add('product', product.id);
      });
      foot.append(button); body.append(foot); card.append(media, body); list.append(card);
    }
    status.textContent = `${filtered.length} equipment item${filtered.length === 1 ? '' : 's'} found${filtered.length > visibleCount ? ` · showing ${visibleCount}` : ''}`;
    (byId('catalog-more') as HTMLButtonElement).hidden = filtered.length <= visibleCount;
  }

  function renderRmsPackages() {
    const query = (byId('rms-package-search') as HTMLInputElement).value.trim().toLowerCase();
    const packages = products.filter((p) => p.isPackage && `${p.name} ${p.group} ${p.description}`.toLowerCase().includes(query));
    const container = byId('rms-package-list'); container.replaceChildren();
    for (const product of packages) {
      const card = el('article', 'catalog-card');
      const media = el('div', 'catalog-card__image');
      if (product.image) { const img = document.createElement('img'); img.src = product.image; img.alt = ''; img.loading = 'lazy'; media.append(img); }
      else media.textContent = 'Image coming soon';
      const body = el('div', 'catalog-card__body');
      body.append(el('span', 'catalog-card__group', product.group), el('h3', '', product.name));
      if (product.description) body.append(el('p', '', product.description.slice(0, 140)));
      const foot = el('div', 'catalog-card__foot');
      foot.append(el('strong', '', product.weekPrice === 0 && product.hasAccessories
        ? 'Configure for a guide price' : rateText(product)));
      const button = el('button', 'btn btn--primary btn--sm', 'View & configure') as HTMLButtonElement;
      button.type = 'button'; button.addEventListener('click', () => openConfig(product.id).catch(() => {
        byId('rms-package-status').textContent = 'Package details could not be loaded. Please try again.';
      }));
      foot.append(button); body.append(foot); card.append(media, body); container.append(card);
    }
    byId('rms-package-status').textContent = `${packages.length} hire package${packages.length === 1 ? '' : 's'} from Current RMS`;
  }

  function renderBasket() {
    basketLines.replaceChildren();
    const count = basket.reduce((sum, line) => sum + line.quantity, 0);
    byId('basket-count').textContent = `${count} item${count === 1 ? '' : 's'}`;
    window.dispatchEvent(new CustomEvent('loudhire:basket-updated', { detail: count }));
    if (!basket.length) { basketLines.append(el('p', 'muted', 'Your basket is empty. Add equipment or a package to get started.')); return; }
    basket.forEach((line, index) => {
      const item = line.type === 'product' ? products.find((p) => p.id === Number(line.id)) : quotePackages.find((p) => p.id === line.id);
      const name = item?.name || (line.type === 'product' ? `Equipment #${line.id}` : 'Package');
      const row = el('div', 'basket-line'); row.append(el('strong', '', name));
      if (line.type === 'package' && item) {
        const pkg = item as QuotePackage;
        row.append(el('small', '', `${pkg.duration} · from ${pounds(pkg.price)} + VAT`));
        if (pkg.extras?.length) {
          const label = el('label', 'basket-extra'); const check = document.createElement('input'); check.type = 'checkbox'; check.checked = line.fullBand === true;
          check.addEventListener('change', () => { line.fullBand = check.checked; save(); });
          label.append(check, document.createTextNode(` Full band option (+${pounds(pkg.extras![0].price)} + VAT)`)); row.append(label);
        }
      } else if (line.type === 'product' && item) {
        const product = item as RmsProduct;
        if (product.hasAccessories || line.components) {
          const wrap = el('div', 'basket-components');
          const detail = details.get(product.id);
          if (detail) {
            row.append(el('small', '', packageGuide(detail, line.components ?? {}, line.quantity)));
            for (const component of detail.components) {
              const perPackage = component.inclusion === 'mandatory' ? component.quantity : line.components?.[String(component.id)] ?? (component.inclusion === 'default' ? component.quantity : 0);
              wrap.append(el('small', '', `${component.name}: ${perPackage * line.quantity}${component.inclusion === 'mandatory' ? ' fixed' : component.inclusion === 'optional' ? ' optional' : ''}`));
            }
          } else {
            row.append(el('small', '', 'Loading package price…'));
            wrap.append(el('small', '', 'Loading package contents…'));
            loadDetail(product.id).then(renderBasket).catch(() => { wrap.replaceChildren(el('small', '', 'Contents unavailable. Please retry later.')); });
          }
          const edit = el('button', '', 'Edit package contents') as HTMLButtonElement;
          edit.type = 'button'; edit.addEventListener('click', () => openConfig(product.id, index).catch(() => { edit.textContent = 'Could not load contents'; }));
          wrap.append(edit); row.append(wrap);
        } else row.append(el('small', '', rateText(product)));
      }
      const actions = el('div', 'basket-line__actions');
      for (const [symbol, delta] of [['−', -1], ['+', 1]] as const) {
        const button = el('button', '', symbol) as HTMLButtonElement; button.type = 'button'; button.setAttribute('aria-label', `${delta < 0 ? 'Remove one' : 'Add one'} ${name}`);
        button.addEventListener('click', () => { line.quantity += delta; if (line.quantity < 1) basket.splice(index, 1); line.quantity = Math.min(100, line.quantity); save(); }); actions.append(button);
      }
      actions.insertBefore(el('span', '', String(line.quantity)), actions.children[1]);
      const remove = el('button', 'remove', 'Remove') as HTMLButtonElement; remove.type = 'button'; remove.addEventListener('click', () => { basket.splice(index, 1); save(); }); actions.append(remove);
      row.append(actions); basketLines.append(row);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.package-add').forEach((button) => button.addEventListener('click', () => add('package', button.dataset.packageId!)));
  document.querySelectorAll<HTMLButtonElement>('.package-tab').forEach((button) => button.addEventListener('click', () => {
    const rms = button.dataset.packageTab === 'RMS hire';
    document.querySelectorAll<HTMLButtonElement>('.package-tab').forEach((tab) => tab.setAttribute('aria-selected', String(tab === button)));
    document.querySelectorAll<HTMLElement>('.package-card').forEach((card) => { card.hidden = rms || card.dataset.packageGroup !== button.dataset.packageTab; });
    byId('rms-package-search-wrap').hidden = !rms;
    byId('rms-package-status').hidden = !rms;
    byId('rms-package-list').hidden = !rms;
    document.querySelector<HTMLElement>('.package-note')!.hidden = rms;
  }));
  (byId('rms-package-search') as HTMLInputElement).addEventListener('input', renderRmsPackages);
  search.addEventListener('input', () => { visibleCount = 24; renderCatalog(); });
  byId('catalog-more').addEventListener('click', () => { visibleCount += 24; renderCatalog(); });
  renderBasket();
  fetch('/api/quote-products').then(async (response) => {
    if (!response.ok) throw new Error('unavailable');
    const result = await response.json(); products = result.products; 
    renderCategoryNav(); renderCatalog(); renderRmsPackages(); renderBasket();
  }).catch(() => { status.textContent = 'The live equipment list is temporarily unavailable. You can still request a package or contact us directly.'; byId('rms-package-status').textContent = 'Live hire packages are temporarily unavailable.'; });

  const periods = byId('periods');
  byId('add-period').addEventListener('click', () => {
    if (periods.children.length >= 12) return;
    const copy = periods.firstElementChild!.cloneNode(true) as HTMLElement;
    copy.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach((input) => { if (input.type === 'checkbox') (input as HTMLInputElement).checked = false; else input.value = ''; });
    copy.querySelector<HTMLButtonElement>('.period-remove')!.hidden = false;
    periods.append(copy); renumberPeriods();
  });
  function renumberPeriods() { periods.querySelectorAll<HTMLElement>('.period-card').forEach((card, index) => { card.querySelector('legend')!.textContent = `Date range ${index + 1}`; }); }
  periods.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest('.period-remove'); if (button) { button.closest('.period-card')?.remove(); renumberPeriods(); } });

  const form = byId('quote-form') as HTMLFormElement;
  const message = byId('quote-message');
  form.addEventListener('submit', async (event) => {
    event.preventDefault(); message.removeAttribute('data-success'); message.textContent = '';
    if (!basket.length) { message.textContent = 'Add at least one item to your basket.'; return; }
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const periodValues = [...periods.querySelectorAll<HTMLElement>('.period-card')].map((card) => ({
      start: (card.querySelector('[name=start]') as HTMLInputElement).value,
      end: (card.querySelector('[name=end]') as HTMLInputElement).value,
      venue: (card.querySelector('[name=venue]') as HTMLTextAreaElement).value,
      delivery: (card.querySelector('[name=delivery]') as HTMLInputElement).checked,
      collection: (card.querySelector('[name=collection]') as HTMLInputElement).checked,
      setup: (card.querySelector('[name=setup]') as HTMLInputElement).checked,
      engineer: (card.querySelector('[name=engineer]') as HTMLInputElement).checked,
    }));
    if (periodValues.some((p) => p.end < p.start)) { message.textContent = 'An end date is before its start date.'; return; }
    const button = byId('quote-submit') as HTMLButtonElement; button.disabled = true; button.textContent = 'Sending…';
    try {
      const response = await fetch('/api/quote-request', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lines: basket, periods: periodValues, organisation: data.get('organisation'), name: data.get('name'), email: data.get('email'), phone: data.get('phone'), address: data.get('address'), notes: data.get('notes'), website: data.get('website') }),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || 'We could not send your request.');
      basket = []; save(); form.reset(); while (periods.children.length > 1) periods.lastElementChild?.remove(); renumberPeriods();
      message.setAttribute('data-success', ''); message.textContent = `Thanks — your request ${result.reference} has been sent. Loud Hire will be in touch with a tailored quote.`;
      message.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (error) { message.textContent = error instanceof Error ? error.message : 'We could not send your request. Please try again.'; }
    finally { button.disabled = false; button.textContent = 'Send quote request'; }
  });
</script>
