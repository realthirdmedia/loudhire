---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getEntries, formatDate, typeLabel, isProject, type Entry } from '../../lib/entries';
import { serviceLabel, site } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Entry };
const { data } = entry;
const { Content } = await render(entry);
const project = isProject(entry);

const all = await getEntries();
const related = all
  .filter((e) => e.id !== entry.id)
  .map((e) => ({ e, score: e.data.services.filter((s) => data.services.includes(s)).length + (e.data.type === data.type ? 0.5 : 0) }))
  .sort((a, b) => b.score - a.score || b.e.data.date.getTime() - a.e.data.date.getTime())
  .slice(0, 3)
  .map((r) => r.e);

const og = await getImage({ src: data.cover, width: 1200, height: 630, format: 'jpg', fit: 'cover' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.summary,
  image: new URL(og.src, Astro.site).href,
  datePublished: data.date.toISOString(),
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: `${site.url}/images/loud-hire-logo.png` } },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  ...(data.location ? { contentLocation: { '@type': 'Place', name: data.location } } : {}),
};

const details: { label: string; value: string }[] = [];
if (data.client) details.push({ label: 'Client', value: data.client });
if (data.location) details.push({ label: 'Location', value: data.location });
if (data.eventType) details.push({ label: 'Event', value: data.eventType });
---

<Base title={data.title} description={data.summary} ogImage={og.src} ogType="article" jsonLd={[articleLd]}>
  <article>
    <header class="entry-head">
      <div class="container container--narrow">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span>/</span>
          <a href="/news-and-projects/">News & Projects</a> <span>/</span>
          <a href={project ? '/news-and-projects/projects/' : '/news-and-projects/news/'}>{project ? 'Projects' : 'News'}</a>
        </nav>
        <div class="entry-head__meta">
          <span class:list={['tag', { 'tag--orange': project }]}>{typeLabel(entry)}</span>
          {!data.hideDate && <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>}
          {data.services.map((s) => <a class="tag tag--outline" href={`/news-and-projects/service/${s}/`}>{serviceLabel[s]}</a>)}
        </div>
        <h1>{data.title}</h1>
        <p class="lead">{data.summary}</p>
      </div>
    </header>

    <div class="container entry-cover">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[768, 1280, 1920]}
        sizes="(max-width: 80rem) 92vw, 1216px"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        format="webp"
        quality={74}
      />
    </div>

    <div class="container entry-body">
      <div class="entry-main">
        {
          project && data.brief && (
            <div class="brief">
              <span class="eyebrow">The brief</span>
              <p>{data.brief}</p>
            </div>
          )
        }
        <div class="prose">
          <Content />
        </div>

        {
          data.testimonial && (
            <figure class="entry-quote">
              <blockquote>
                <p>"{data.testimonial.quote}"</p>
              </blockquote>
              <figcaption>{data.testimonial.name}</figcaption>
            </figure>
          )
        }
      </div>

      <aside class="entry-aside">
        {
          (details.length > 0 || data.servicesDelivered) && (
            <div class="panel">
              <h2 class="panel__title">Project details</h2>
              {details.length > 0 && (
                <dl class="details">
                  {details.map((d) => (
                    <div>
                      <dt>{d.label}</dt>
                      <dd>{d.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {data.servicesDelivered && (
                <>
                  <h3 class="panel__sub">Services delivered</h3>
                  <ul class="delivered">
                    {data.servicesDelivered.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </>
              )}
              {data.services.length > 0 && (
                <div class="tag-row">
                  {data.services.map((s) => (
                    <a class="tag" href={`/event-production/${s}/`}>
                      {serviceLabel[s]}
                    </a>
                  ))}
                </div>
              )}
            </div>
          )
        }
        <div class="panel panel--cta">
          <h2 class="panel__title">Planning something similar?</h2>
          <p>Tell us about the event and we will come back with a clear recommendation and a quote.</p>
          <a class="btn btn--primary" href="/contact/">Discuss your event</a>
          <a class="text-link" href="/event-production/">Event production services</a>
        </div>
      </aside>
    </div>

    {
      data.gallery && data.gallery.length > 0 && (
        <section class="container entry-gallery">
          <h2 class="visually-hidden">Gallery</h2>
          <div class="gallery">
            {data.gallery.map((g) => (
              <figure class="gallery__item">
                <Image src={g.src} alt={g.alt} widths={[480, 800, 1200]} sizes="(max-width: 48rem) 92vw, 600px" loading="lazy" decoding="async" format="webp" quality={72} />
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section class="section section--paper-2">
        <div class="container">
          <div class="section-head section-head--split">
            <div>
              <span class="eyebrow">Related</span>
              <h2>More news and projects</h2>
            </div>
            <a class="text-link" href="/news-and-projects/">See all</a>
          </div>
          <div class="grid grid--3">
            {related.map((r) => (
              <EntryCard entry={r} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <ContactSection />
</Base>

<style>
  .entry-head {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .crumb {
    font-size: var(--text-xs);
    color: var(--c-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .crumb a {
    text-decoration: none;
  }
  .entry-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1rem;
    font-size: var(--text-xs);
    color: var(--c-muted);
  }
  .entry-head h1 {
    max-width: 24ch;
  }
  .entry-cover :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--c-paper-3);
  }
  .entry-body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .brief {
    padding: 1.25rem 1.5rem;
    background: var(--c-orange-soft);
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
  }
  .brief p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--c-ink);
    line-height: 1.45;
  }
  .brief .eyebrow {
    margin-bottom: 0.4rem;
  }
  .entry-quote {
    margin: 2.5rem 0 0;
    padding: 1.75rem 2rem;
    background: var(--c-black);
    color: #fff;
    border-radius: var(--radius-lg);
  }
  .entry-quote blockquote {
    margin: 0 0 0.75rem;
  }
  .entry-quote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: 1.35;
  }
  .entry-quote figcaption {
    color: var(--c-orange);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .entry-aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: 1.25rem;
  }
  .panel {
    background: var(--c-paper-2);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.6rem;
  }
  .panel--cta {
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    display: grid;
    gap: 0.75rem;
  }
  .panel--cta p {
    margin: 0;
    color: var(--c-muted);
    font-size: var(--text-sm);
  }
  .panel__title {
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .panel__sub {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin: 1.25rem 0 0.6rem;
  }
  .details {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .details div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    font-size: var(--text-sm);
  }
  .details dt {
    color: var(--c-muted);
  }
  .details dd {
    margin: 0;
    color: var(--c-ink);
    font-weight: 500;
  }
  .delivered {
    margin: 0 0 1.25rem;
    padding-left: 1.1rem;
    font-size: var(--text-sm);
  }
  .delivered li + li {
    margin-top: 0.35rem;
  }
  .entry-gallery {
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .gallery__item {
    margin: 0;
  }
  .gallery__item :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--c-paper-3);
  }
  .gallery__item figcaption {
    font-size: var(--text-xs);
    color: var(--c-muted);
    margin-top: 0.5rem;
  }
  @media (max-width: 64rem) {
    .entry-body {
      grid-template-columns: 1fr;
    }
    .entry-aside {
      position: static;
    }
  }
  @media (max-width: 40rem) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
