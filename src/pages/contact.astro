---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../data/site';

const title = 'Contact Loud Hire | Discuss Your Event or Equipment Hire';
const description =
  'Call 0117 214 1470, email info@loudhire.co.uk or send a short enquiry. Loud Hire is based at Hacket Lane, Thornbury, Bristol BS35 3TY and serves Bristol, the Cotswolds and the South West. Warehouse visits by appointment.';
---

<Base title={title} description={description}>
  <section class="section contact">
    <div class="container contact__grid">
      <div class="contact__intro">
        <span class="eyebrow">Contact</span>
        <h1>Discuss your event</h1>
        <p class="lead">
          Tell us what you are planning, even if the date or the details are still moving. We aim to reply within one working day, and site visits across Bristol and the Cotswolds are free.
        </p>

        <dl class="contact__list">
          <div>
            <dt>Call</dt>
            <dd><a href={site.phoneHref}>{site.phone}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>WhatsApp</dt>
            <dd><a href={site.whatsapp} rel="noopener">Message us on WhatsApp</a></dd>
          </div>
          <div>
            <dt>Warehouse</dt>
            <dd>
              {site.address.street}, {site.address.town}, {site.address.city} {site.address.postcode}<br />
              <span class="muted">Visits by appointment. <a href={site.mapsHref} rel="noopener">Directions</a></span>
            </dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd>Monday to Friday, 9am to 5pm<br /><span class="muted">Event support runs seven days a week</span></dd>
          </div>
        </dl>

        <p class="contact__note">
          Further afield? We cover the whole of the UK for the right project, from London to Devon. Tell us where and we will let you know what is possible.
        </p>
      </div>

      <div class="contact__form" id="enquiry">
        <p class="contact__error" id="contact-error" role="alert" hidden></p>
        <EnquiryForm id="contact-form" heading="Send an enquiry" />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .contact__list {
    margin: 2rem 0 0;
    display: grid;
    gap: 1rem;
  }
  .contact__list div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--c-line);
    line-height: 1.5;
  }
  .contact__list dt {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-orange-deep);
    padding-top: 0.35rem;
  }
  .contact__list dd {
    margin: 0;
  }
  .contact__list dd > a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--c-ink);
    text-decoration: none;
  }
  .contact__list dd > a:hover {
    color: var(--c-orange-deep);
  }
  .contact__note {
    margin-top: 1.5rem;
    font-size: var(--text-sm);
    color: var(--c-muted);
  }
  .contact__form {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .contact__error {
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: #fdecec;
    color: #8a1f1f;
    font-weight: 500;
  }
  @media (max-width: 64rem) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Prefill the message from links such as /contact/?item=SQ6 or ?subject=dry-hire,
  // and surface any error passed back by the no-JavaScript submission path.
  const params = new URLSearchParams(location.search);
  const message = document.querySelector<HTMLTextAreaElement>('#contact-form-message');
  const item = params.get('item');
  const subject = params.get('subject');
  if (message && !message.value) {
    if (item) message.value = `I'd like to enquire about hiring: ${item}\n\nDates: \nCollection or delivery: \n`;
    else if (subject === 'dry-hire') message.value = 'Equipment hire enquiry.\n\nItems: \nDates: \nCollection or delivery: \n';
    else if (subject?.startsWith('dry-hire-')) message.value = `Equipment hire enquiry (${subject.replace('dry-hire-', '')}).\n\nItems: \nDates: \nCollection or delivery: \n`;
    else if (subject === 'venue-lease') message.value = 'Venue lease enquiry.\n\nVenue: \nWhat you need: \n';
    else if (subject) message.value = `Enquiry about: ${subject}\n\n`;
  }
  const error = params.get('error');
  const errorEl = document.getElementById('contact-error');
  if (error && errorEl) {
    errorEl.textContent = error;
    errorEl.hidden = false;
  }
</script>
