---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../data/site';
import heroImage from '../assets/projects/proms-in-the-park/foh.jpg';
import imgWarehouse from '../assets/news/wireless-microphone-hire/4-way-rack.jpg';
import imgStage from '../assets/projects/ilford-queens-jubilee/line-array.jpg';
import imgCrowd from '../assets/projects/the-wurzels/night-crowd.jpg';

const clients = [
  'Hawkstone',
  'Bath Racecourse',
  'Aerospace Bristol',
  'Gloucester Tall Ships Festival',
  'NFU Mutual',
  'British Airways',
  'Shield Group',
  'InIlford',
  'Skyburst Fireworks',
  'Misplaced Theatre',
  'The Wurzels',
  'Eats Everything',
];

const title = 'About Loud Hire | Event Production Company in Thornbury, near Bristol';
const description =
  'Loud Hire is an event production and equipment hire company based in Thornbury, near Bristol, with more than 30 years in professional audio and events. Sound, lighting, staging, video and power for Bristol, the Cotswolds and the South West.';
---

<Base title={title} description={description}>
  <PageHero
    variant="banner"
    image={heroImage}
    imageAlt="Mixing console at front of house looking towards an outdoor stage"
    eyebrow="About Loud Hire"
    title="Established, organised and hands-on."
    intro="An event production company based in Thornbury, just north of Bristol, delivering sound, lighting, staging, video and power across Bristol, the Cotswolds and the wider South West."
    ctaLabel="Discuss your event"
    ctaHref="/contact/"
  />

  <section class="section">
    <div class="container about">
      <div class="prose about__text">
        <h2>Who we are</h2>
        <p>
          Loud Hire began as a PA and lighting hire company and has grown into a complete event production partner. Our team has more than 30 years of experience in professional audio and live events, and in a single year we have supplied equipment and crew to more than 300 events, from a lectern in a boardroom to a main stage for 5,000 people.
        </p>
        <p>
          We are a dynamic, hands-on team led by director Tom Grey. Every client has one named contact from the first call to the de-rig, and the people who plan your event are the people who turn up to build it.
        </p>
        <h2>How we work</h2>
        <p>
          We believe planning and preparation matter as much as the delivery on the day. Events are designed in advance, with CAD site layouts and written plans where the job calls for them, so every member of the crew, full-time and freelance, knows their role on site. All of our equipment is tested in our Thornbury warehouse before every event and again when it returns. Nothing arrives fresh off another job without being checked and prepped.
        </p>
        <p>
          We only quote for what an event needs and we only describe services we actually provide. For large outdoor stages we work with our sister company <a href={site.sisterCompany.url} rel="noopener">{site.sisterCompany.name}</a>, so the stage and everything on it come from one plan.
        </p>
        <h2>Where we work</h2>
        <p>
          Our warehouse is in Thornbury, which puts Bristol, Bath, Gloucester and the Cotswolds within an hour. Most of our work is across Bristol, the Cotswolds and the wider South West, and being local means we can visit a site before we quote and support venues seven days a week. We travel further for the right project, and have delivered events in London, Devon and Wales.
        </p>
        <h2>Insurance and safety</h2>
        <p>
          Loud Hire holds public liability, employers' liability and professional indemnity insurance. Rigging, power and structures are planned and built by experienced crew, and we are happy to supply documentation for venues and organisers.
        </p>
      </div>
      <aside class="about__aside">
        <div class="about__photo">
          <Image src={imgWarehouse} alt="Wireless microphone rack ready for hire in the Loud Hire warehouse" widths={[480, 720]} sizes="(max-width: 64rem) 92vw, 400px" loading="lazy" decoding="async" format="webp" quality={70} />
        </div>
        <div class="about__photo">
          <Image src={imgStage} alt="Line array flown from a trailer stage roof on a high street" widths={[480, 720]} sizes="(max-width: 64rem) 92vw, 400px" loading="lazy" decoding="async" format="webp" quality={70} />
        </div>
        <div class="about__photo">
          <Image src={imgCrowd} alt="Crowd in front of a lit stage at night" widths={[480, 720]} sizes="(max-width: 64rem) 92vw, 400px" loading="lazy" decoding="async" format="webp" quality={70} />
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Clients and partners</span>
        <h2>Who we have worked with</h2>
        <p>A selection of the brands, venues, organisers and artists featured in our projects.</p>
      </div>
      <ul class="clients">
        {clients.map((c) => <li>{c}</li>)}
      </ul>
      <p class="clients__more"><a class="text-link" href="/news-and-projects/projects/">See the projects</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container facts">
      <div class="fact">
        <strong>Thornbury, Bristol</strong>
        <span>{site.addressLine}</span>
      </div>
      <div class="fact">
        <strong>Bristol, the Cotswolds, the South West</strong>
        <span>Free site visits across the region</span>
      </div>
      <div class="fact">
        <strong>30+ years</strong>
        <span>In professional audio and live events</span>
      </div>
      <div class="fact">
        <strong>Fully insured</strong>
        <span>Public liability, employers' liability, professional indemnity</span>
      </div>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .about__text :global(h2:first-child) {
    margin-top: 0;
  }
  .about__aside {
    display: grid;
    gap: 1rem;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .about__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .clients {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .clients li {
    padding: 1rem 1.1rem;
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--c-ink);
  }
  .clients__more {
    margin: 1.5rem 0 0;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .fact {
    display: grid;
    gap: 0.25rem;
    padding-left: 1rem;
    border-left: 1px solid var(--c-line);
    font-size: var(--text-sm);
    color: var(--c-muted);
  }
  .fact strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--c-ink);
  }
  @media (max-width: 64rem) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__aside {
      position: static;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .clients,
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .about__aside {
      grid-template-columns: 1fr;
    }
    .clients,
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
